# AutoSLM control plane (operator-side). Copy to .env and fill in.
# Provider credentials live ONLY here — clients authenticate with claimed
# AutoSLM keys (`slm login`).
RUNPOD_API_KEY=
# HuggingFace token with write access to HF_REPO (code upload + streamed
# checkpoints/adapters land there).
HUGGINGFACE_TOKEN=
# Private HF *dataset* repo used as the artifact store, e.g. org/autoslm-runs
HF_REPO=
