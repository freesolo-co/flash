app = modal.App(APP_NAME, image=image)
cache_volume = modal.Volume.from_name(f"{APP_NAME}-cache", create_if_missing=True)
# durable records survive cold starts; this dict is storage, not a distributed lock.
adapter_records = modal.Dict.from_name(f"{APP_NAME}-adapters", create_if_missing=True)
secrets = [modal.Secret.from_name(SECRET_NAME, required_keys=["HF_TOKEN"])]

_REVISION_ID_RE = re.compile(ADAPTER_REVISION_PATTERN)
# the api is pinned to one container, so these locks make alias compare-and-swap atomic locally.
_RUN_LOCKS: dict[str, asyncio.Lock] = {}


def _utc_now() -> str:
    from datetime import UTC, datetime

    return datetime.now(UTC).isoformat()


def _adapter_digest(adapter_id: str) -> str:
    return hashlib.sha1(adapter_id.encode()).hexdigest()


def _record_key(adapter_id: str) -> str:
    return f"record:{adapter_id}"


def _lock_for_run(run_id: str) -> asyncio.Lock:
    return _RUN_LOCKS.setdefault(run_id, asyncio.Lock())


async def _read(adapter_id: str) -> dict[str, Any] | None:
    return await adapter_records.get.aio(_record_key(adapter_id))


async def _write(record: dict[str, Any]) -> None:
    record["updated_at"] = _utc_now()
    await adapter_records.put.aio(_record_key(record["adapter_id"]), record)


async def _records_for_run(run_id: str) -> list[dict[str, Any]]:
    records = []
    async for key in adapter_records.keys.aio():
        if not isinstance(key, str) or not key.startswith("record:"):
            continue
        record = await adapter_records.get.aio(key)
        if isinstance(record, dict) and (record.get("metadata") or {}).get("run_id") == run_id:
            records.append(record)
    return records


def _fingerprint(record: dict[str, Any]) -> tuple:
    metadata = record.get("metadata") or {}
    return (
        record.get("repo_id"),
        record.get("repo_type"),
        record.get("subfolder"),
        record.get("base_model"),
        record.get("checkpoint"),
        bool(record.get("thinking")),
        record.get("org_id") or None,
        record.get("structured_outputs") or None,
        metadata.get("run_id"),
        metadata.get("checkpoint_step"),
        metadata.get("hf_revision"),
    )


def _adapter_spec(record: dict[str, Any], path: str) -> AdapterSpec:
    """translate a durable record plus its downloaded path into a runtime adapter incarnation.

    the incarnation carries the settle attempt so a stale settlement cannot unload the adapter a
    later attempt registered. revision ids are immutable, so the id alone is the fallback identity.
    """
    metadata = record.get("metadata") or {}
    adapter_id = record["adapter_id"]
    attempt = metadata.get("settle_attempt")
    return AdapterSpec(
        adapter_id=adapter_id,
        path=path,
        incarnation=f"{adapter_id}@{attempt}" if attempt is not None else adapter_id,
        thinking=bool(record.get("thinking")),
        structured_outputs=record.get("structured_outputs") or None,
    )


def _canonical_step(value: Any) -> int | str | None:
    if value is None:
        return None
    try:
        exact = int(value)
    except (TypeError, ValueError):
        return repr(value)
    if isinstance(value, float) and (value != exact or value != value):
        return repr(value)
    return exact


def _registration_record(payload: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    adapter_id = str(payload.get("adapter_id") or "").strip()
    metadata = payload.get("metadata")
    if metadata is None:
        metadata = {}
    if not isinstance(metadata, dict):
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_ENTITY,
            f"metadata must be an object, got {type(metadata).__name__}",
        )
    run_id = str(metadata.get("run_id") or "").strip()
    if not adapter_id or not run_id:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_ENTITY, "adapter_id and run_id are required"
        )
    if payload.get("base_model") != BASE_MODEL:
        raise HTTPException(
            status.HTTP_409_CONFLICT,
            f"this app serves {BASE_MODEL}, not {payload.get('base_model')}",
        )
    parsed = _REVISION_ID_RE.fullmatch(adapter_id)
    if parsed is None:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_ENTITY,
            f"adapter_id {adapter_id!r} is not an immutable revision id "
            "(<run_id>@final.<40-hex sha> or <run_id>@step-<N>.<40-hex sha>)",
        )
    expected_step = parsed.group("step")
    supplied = (
        run_id,
        str(metadata.get("hf_revision") or "").strip(),
        _canonical_step(metadata.get("checkpoint_step")),
    )
    expected = (
        parsed.group("run_id"),
        parsed.group("hf_revision"),
        None if expected_step is None else int(expected_step),
    )
    names = ("run_id", "hf_revision", "checkpoint_step")
    mismatched = [
        f"{name}={actual!r} (id says {wanted!r})"
        for name, actual, wanted in zip(names, supplied, expected, strict=True)
        if actual != wanted
    ]
    if mismatched:
        raise HTTPException(
            status.HTTP_422_UNPROCESSABLE_ENTITY,
            f"metadata disagrees with the revision id {adapter_id}: {', '.join(mismatched)}",
        )
    canonical_metadata = {
        **metadata,
        "run_id": run_id,
        "checkpoint_step": expected[2],
        "hf_revision": expected[1],
        "record_type": "revision",
        "lifecycle_state": "registered",
        "settle_attempt": uuid.uuid4().hex,
    }
    return run_id, {
        "adapter_id": adapter_id,
        "repo_id": payload.get("repo_id"),
        "repo_type": payload.get("repo_type") or "model",
        "subfolder": payload.get("subfolder"),
        "base_model": payload.get("base_model"),
        "checkpoint": payload.get("checkpoint"),
        "thinking": bool(payload.get("thinking")),
        "org_id": payload.get("org_id"),
        "structured_outputs": payload.get("structured_outputs"),
        "status": "registered",
        "metadata": canonical_metadata,
    }


@app.cls(
    gpu=GPU,
    image=image,
    secrets=secrets,
    volumes={CACHE_MOUNT: cache_volume},
    max_containers=1,
    scaledown_window=SCALEDOWN_WINDOW_SECONDS,
    startup_timeout=STARTUP_TIMEOUT_SECONDS,
    timeout=TIMEOUT_SECONDS,
)
@modal.concurrent(max_inputs=MAX_NUM_SEQS)
class Engine(RuntimeContainer):
    def engine_config(self) -> EngineConfig:
        return EngineConfig(
            model=BASE_MODEL,
            trust_remote_code=True,
            max_loras=MAX_LORAS,
            max_lora_rank=MAX_LORA_RANK,
            engine_args={
                "quantization": QUANTIZATION,
                "kv_cache_dtype": KV_CACHE_DTYPE,
                "max_model_len": MAX_MODEL_LEN,
                "max_num_seqs": MAX_NUM_SEQS,
                "gpu_memory_utilization": GPU_MEMORY_UTILIZATION,
                **(
                    {"max_num_batched_tokens": MAX_NUM_BATCHED_TOKENS}
                    if MAX_NUM_BATCHED_TOKENS
                    else {}
                ),
            },
        )

    @modal.enter()
    async def load(self) -> None:
        # one engine container owns the gpu and its lora slots, so adapter identity and cache
        # lifetime use process-local locks instead of cross-container consensus.
        self._locks: dict[str, asyncio.Lock] = {}
        # adapter id -> the exact incarnation this container registered, so an unload can be fenced.
        self._registered: dict[str, str] = {}
        await self.start_runtime()

    async def _adapter_path(self, record: dict[str, Any]) -> str:
        from huggingface_hub import snapshot_download

        adapter_id = record["adapter_id"]
        target = f"{ADAPTER_DIR}/{_adapter_digest(adapter_id)}"
        subfolder = record.get("subfolder") or ""
        pattern = f"{subfolder}/*" if subfolder else "*"
        path = await asyncio.to_thread(
            snapshot_download,
            repo_id=record["repo_id"],
            repo_type=record.get("repo_type") or "model",
            revision=(record.get("metadata") or {}).get("hf_revision") or None,
            allow_patterns=[pattern],
            local_dir=target,
            token=os.environ.get("HF_TOKEN"),
        )
        return f"{path}/{subfolder}" if subfolder else path

    async def _delete_adapter_cache_locked(self, adapter_id: str) -> None:
        directory = f"{ADAPTER_DIR}/{_adapter_digest(adapter_id)}"
        with contextlib.suppress(FileNotFoundError):
            await asyncio.to_thread(shutil.rmtree, directory)

    async def _load_lora_locked(self, record: dict[str, Any]) -> None:
        adapter_id = record["adapter_id"]
        if adapter_id in self._registered:
            return
        current = await _read(adapter_id)
        state = (current.get("metadata") or {}).get("lifecycle_state") if current else None
        if current and (current.get("status") == "disabled" or state in ("disabled", "failed")):
            raise RuntimeError(f"{adapter_id} was undeployed before it could load")
        path = await self._adapter_path(record)
        spec = _adapter_spec(record, path)
        await self.runtime.register_adapter(spec)
        self._registered[adapter_id] = spec.incarnation
        # the record can flip to disabled while weights were loading, so re-read and undo.
        latest = await _read(adapter_id)
        latest_state = (latest.get("metadata") or {}).get("lifecycle_state") if latest else None
        if latest and (
            latest.get("status") == "disabled" or latest_state in ("disabled", "failed")
        ):
            await self._unload_locked(adapter_id)
            raise RuntimeError(f"{adapter_id} was undeployed while it was loading")

    async def _ensure_loaded(self, record: dict[str, Any]) -> None:
        if record["adapter_id"] in self._registered:
            return
        async with self._locks.setdefault(record["adapter_id"], asyncio.Lock()):
            await self._load_lora_locked(record)

    async def _unload_locked(self, adapter_id: str) -> bool:
        incarnation = self._registered.get(adapter_id)
        if incarnation is None:
            await self._delete_adapter_cache_locked(adapter_id)
            return True
        try:
            await self.runtime.unload_adapter(adapter_id, expected_incarnation=incarnation)
        except Exception:
            return False
        self._registered.pop(adapter_id, None)
        await self._delete_adapter_cache_locked(adapter_id)
        return True

    @modal.method()
    async def settle(self, record: dict[str, Any]) -> dict[str, Any]:
        adapter_id = record["adapter_id"]
        attempt = (record.get("metadata") or {}).get("settle_attempt")
        async with self._locks.setdefault(adapter_id, asyncio.Lock()):
            failure = None
            try:
                await self._load_lora_locked(record)
            except Exception as exc:
                failure = f"{type(exc).__name__}: {exc}"
            current = await _read(adapter_id)
            if not isinstance(current, dict):
                if failure is not None and adapter_id not in self._registered:
                    await self._delete_adapter_cache_locked(adapter_id)
                return {"ok": False}
            metadata = current.get("metadata") or {}
            if attempt is not None and metadata.get("settle_attempt") != attempt:
                return {"ok": True, "superseded": True}
            if current.get("status") == "disabled":
                await self._unload_locked(adapter_id)
                return {"ok": True, "superseded": True}
            if failure is None:
                current["status"] = "ready"
                current["metadata"] = {**metadata, "lifecycle_state": "ready"}
            else:
                current["status"] = "disabled"
                current["metadata"] = {
                    **metadata,
                    "lifecycle_state": "failed",
                    "failure": failure,
                }
            await _write(current)
            if failure is not None and adapter_id not in self._registered:
                await self._delete_adapter_cache_locked(adapter_id)
            return {"ok": failure is None, "failure": failure}

    @modal.method()
    async def unregister(self, adapter_id: str) -> dict[str, Any]:
        async with self._locks.setdefault(adapter_id, asyncio.Lock()):
            current = await _read(adapter_id)
            if isinstance(current, dict) and current.get("status") != "disabled":
                return {"ok": True, "evicted": False, "revived": True}
            evicted = await self._unload_locked(adapter_id)
            return {"ok": True, "evicted": evicted}

    async def _request(self, payload: dict[str, Any], record: dict[str, Any]):
        await self._ensure_loaded(record)
        adapter_id = record["adapter_id"]
        return GenerationRequest(
            adapter_id=adapter_id,
            expected_incarnation=self._registered[adapter_id],
            messages=payload.get("messages") or [],
            max_tokens=int(payload.get("max_tokens") or 512),
            temperature=float(payload.get("temperature") or 0.0),
            top_p=float(payload.get("top_p") or 1.0),
            stop=payload.get("stop") or None,
            chat_template_kwargs=dict(payload.get("chat_template_kwargs") or {}),
        )

    @modal.method()
    async def generate(self, payload: dict[str, Any], record: dict[str, Any]) -> dict[str, Any]:
        result = await self.runtime.generate(await self._request(payload, record))
        return {
            "text": result.text,
            "finish_reason": result.finish_reason,
            "prompt_tokens": result.prompt_tokens,
            "completion_tokens": result.completion_tokens,
        }

    @modal.method(is_generator=True)
    async def generate_stream(self, payload: dict[str, Any], record: dict[str, Any]):
        request = await self._request(payload, record)
        finish_reason = None
        async for event in self.runtime.stream(request):
            # the runtime already yields normalized deltas, so no cumulative slicing is needed.
            if isinstance(event, StreamDelta):
                yield {"delta": event.text, "finish_reason": None}
            elif isinstance(event, StreamFinished):
                finish_reason = event.finish_reason
        yield {"delta": "", "finish_reason": finish_reason or "stop"}


engine = Engine()


@app.function(image=image, secrets=secrets, timeout=TIMEOUT_SECONDS)
async def settle_adapter(record: dict[str, Any]) -> None:
    try:
        await engine.settle.remote.aio(record)
    except Exception as exc:
        adapter_id = record["adapter_id"]
        current = await _read(adapter_id)
        attempt = (record.get("metadata") or {}).get("settle_attempt")
        metadata = current.get("metadata") or {} if isinstance(current, dict) else {}
        if (
            isinstance(current, dict)
            and metadata.get("settle_attempt") == attempt
            and current.get("status") == "registered"
            and metadata.get("lifecycle_state") == "registered"
        ):
            current["status"] = "disabled"
            current["metadata"] = {
                **metadata,
                "lifecycle_state": "failed",
                "failure": f"the serving engine did not answer: {exc}",
            }
            await _write(current)


def _require_key(request: Request) -> None:
    expected = (os.environ.get("FLASH_SERVING_KEY") or "").strip()
    if not expected:
        return
    presented = (request.headers.get("X-Freesolo-Internal-Key") or "").strip()
    if not hmac.compare_digest(presented, expected):
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "invalid serving key")


async def _ensure_run_alias(run_id: str) -> None:
    if await _read(run_id) is None:
        await _write(
            {
                "adapter_id": run_id,
                "base_model": BASE_MODEL,
                "status": "disabled",
                "metadata": {"record_type": "alias", "run_id": run_id, "alias_of": None},
            }
        )


async def _spawn_settle(record: dict[str, Any]) -> None:
    try:
        settle_adapter.spawn(record)
    except Exception as exc:
        current = await _read(record["adapter_id"])
        attempt = (record.get("metadata") or {}).get("settle_attempt")
        if (
            isinstance(current, dict)
            and (current.get("metadata") or {}).get("settle_attempt") == attempt
        ):
            current["status"] = "disabled"
            current["metadata"] = {
                **(current.get("metadata") or {}),
                "lifecycle_state": "failed",
                "failure": f"could not enqueue the adapter load: {exc}",
            }
            await _write(current)
        raise


async def healthz() -> dict[str, Any]:
    return {
        "ok": True,
        "base_models": [BASE_MODEL],
        "gpu": GPU,
        "requires_key": bool((os.environ.get("FLASH_SERVING_KEY") or "").strip()),
        "capabilities": list(SERVING_CAPABILITIES),
    }


async def register_adapter(payload: dict[str, Any], request: Request) -> dict[str, Any]:
    _require_key(request)
    run_id, record = _registration_record(payload)
    async with _lock_for_run(run_id):
        existing = await _read(record["adapter_id"])
        if existing is not None:
            if _fingerprint(existing) != _fingerprint(record):
                raise HTTPException(
                    status.HTTP_409_CONFLICT, "immutable adapter revision already exists"
                )
            await _ensure_run_alias(run_id)
            state = (existing.get("metadata") or {}).get("lifecycle_state")
            if state == "ready":
                return {"ok": True, "adapter": existing}
            existing["status"] = "registered"
            existing["metadata"] = {
                **(existing.get("metadata") or {}),
                "lifecycle_state": "registered",
                "settle_attempt": uuid.uuid4().hex,
            }
            existing["metadata"].pop("failure", None)
            await _write(existing)
            await _spawn_settle(existing)
            return {"ok": True, "adapter": existing}
        await _ensure_run_alias(run_id)
        await _write(record)
        await _spawn_settle(record)
        return {"ok": True, "adapter": record}


async def get_adapter(adapter_id: str, request: Request, response: Response) -> dict[str, Any]:
    _require_key(request)
    record = await _read(adapter_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter id")
    if (record.get("metadata") or {}).get("lifecycle_state") == "registered":
        response.headers["Retry-After"] = "2"
    return {"ok": True, "adapter": record}


async def activate(revision_id: str, payload: dict[str, Any], request: Request) -> dict[str, Any]:
    _require_key(request)
    revision = await _read(revision_id)
    if revision is None or (revision.get("metadata") or {}).get("record_type") != "revision":
        raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter revision")
    run_id = (revision.get("metadata") or {}).get("run_id")
    async with _lock_for_run(run_id):
        revision = await _read(revision_id)
        if revision is None or revision.get("status") != "ready":
            raise HTTPException(status.HTTP_409_CONFLICT, "adapter revision is not ready")
        alias = await _read(run_id)
        if alias is None:
            raise HTTPException(status.HTTP_409_CONFLICT, "run alias is missing")
        previous = (
            None
            if alias.get("status") == "disabled"
            else (alias.get("metadata") or {}).get("alias_of")
        )
        if payload.get("expected_adapter_revision") != previous:
            raise HTTPException(status.HTTP_409_CONFLICT, "stale adapter revision expectation")
        alias["status"] = "ready"
        alias["metadata"] = {
            "record_type": "alias",
            "run_id": run_id,
            "alias_of": revision_id,
        }
        await _write(alias)
    return {
        "adapter_id": run_id,
        "target_adapter_revision": revision_id,
        "previous_adapter_revision": previous,
        "checkpoint": revision.get("checkpoint"),
        "updated_at": alias["updated_at"],
    }


async def remove(adapter_id: str, request: Request) -> dict[str, Any]:
    _require_key(request)
    record = await _read(adapter_id)
    if record is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter id")
    run_id = (record.get("metadata") or {}).get("run_id") or adapter_id
    disabled_aliases: list[str] = []
    disabled_revisions: list[str] = []
    async with _lock_for_run(run_id):
        records = await _records_for_run(run_id)
        for candidate in records:
            metadata = candidate.get("metadata") or {}
            if candidate.get("status") != "disabled":
                candidate["status"] = "disabled"
                candidate["metadata"] = {**metadata, "lifecycle_state": "disabled"}
                await _write(candidate)
                target = (
                    disabled_aliases
                    if metadata.get("record_type") == "alias"
                    else disabled_revisions
                )
                target.append(candidate["adapter_id"])
        revisions = [
            candidate["adapter_id"]
            for candidate in records
            if (candidate.get("metadata") or {}).get("record_type") == "revision"
        ]
    for revision_id in revisions:
        try:
            await engine.unregister.remote.aio(revision_id)
        except Exception:
            continue
    return {
        "ok": True,
        "run_id": run_id,
        "disabled_aliases": disabled_aliases,
        "disabled_revisions": disabled_revisions,
    }


def _validate_chat_payload(payload: dict[str, Any]) -> None:
    for message in payload.get("messages") or []:
        content = message.get("content") if isinstance(message, dict) else None
        if not isinstance(content, list):
            continue
        if any(
            isinstance(block, dict) and block.get("type") in IMAGE_BLOCK_TYPES
            for block in content
        ):
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST,
                "this serving backend is text-only: it does not decode images or pass "
                "multi_modal_data to vLLM, so serving an image-bearing request would answer "
                "without seeing the image",
            )
    limit = payload.get("max_tokens")
    if limit is not None and (not isinstance(limit, int) or isinstance(limit, bool) or limit < 1):
        raise HTTPException(
            status.HTTP_400_BAD_REQUEST,
            f"max_tokens must be a positive integer, got {limit!r}",
        )
    for field, low, high, low_ok in (
        ("temperature", 0.0, None, True),
        ("top_p", 0.0, 1.0, False),
    ):
        value = payload.get(field)
        if value is None:
            continue
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST, f"{field} must be a number, got {value!r}"
            )
        if not math.isfinite(value):
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST, f"{field} must be finite, got {value!r}"
            )
        if (value < low if low_ok else value <= low) or (high is not None and value > high):
            bound = f"in ({low}, {high}]" if high is not None else f">= {low}"
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST, f"{field} must be {bound}, got {value!r}"
            )


async def _resolve_chat_record(requested: str) -> dict[str, Any] | JSONResponse:
    record = await _read(requested)
    if record is None or record.get("status") == "disabled":
        raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {requested}")
    metadata = record.get("metadata") or {}
    if metadata.get("record_type") == "alias":
        target = metadata.get("alias_of")
        record = await _read(target) if target else None
        if record is None:
            raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {requested}")
    state = (record.get("metadata") or {}).get("lifecycle_state")
    if record.get("status") == "disabled" or state in ("disabled", "failed"):
        raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {requested}")
    if state != "ready":
        return JSONResponse(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            headers={"Retry-After": "2"},
            content={
                "error": {
                    "type": "adapter_unavailable",
                    "code": "adapter_loading",
                    "retryable": True,
                    "requested_model": requested,
                    "adapter_revision": requested,
                    "retry_after_seconds": 2,
                }
            },
        )
    return record


def _provenance(record: dict[str, Any]) -> tuple[dict[str, str], dict[str, str]]:
    revision = record["adapter_id"]
    checkpoint = record.get("checkpoint") or ""
    hf_revision = (record.get("metadata") or {}).get("hf_revision") or revision.rsplit(".", 1)[-1]
    body = {
        "adapter_revision": revision,
        "checkpoint": checkpoint,
        "hf_revision": hf_revision,
    }
    headers = {
        "X-Freesolo-Adapter-Revision": revision,
        "X-Freesolo-Checkpoint": checkpoint,
        "X-Freesolo-HF-Revision": hf_revision,
    }
    return body, headers


async def _sse_events(
    payload: dict[str, Any],
    record: dict[str, Any],
    requested: str,
    provenance: dict[str, str],
    started: float,
):
    chunk_id = f"chatcmpl-{uuid.uuid4().hex}"
    created = int(started)

    def chunk(delta: dict[str, Any], finish_reason: str | None) -> str:
        frame = {
            "id": chunk_id,
            "object": "chat.completion.chunk",
            "created": created,
            "model": requested,
            "choices": [{"index": 0, "delta": delta, "finish_reason": finish_reason}],
            "freesolo": provenance,
        }
        return f"data: {json.dumps(frame)}\n\n"

    yield chunk({"role": "assistant", "content": ""}, None)
    async for piece in engine.generate_stream.remote_gen.aio(payload, record):
        if piece.get("finish_reason"):
            yield chunk({}, piece["finish_reason"])
        elif piece.get("delta"):
            yield chunk({"content": piece["delta"]}, None)
    yield "data: [DONE]\n\n"


async def chat_completions(payload: dict[str, Any], request: Request):
    _require_key(request)
    _validate_chat_payload(payload)
    requested = str(payload.get("model") or "")
    resolved = await _resolve_chat_record(requested)
    if isinstance(resolved, JSONResponse):
        return resolved
    record = resolved
    started = time.time()
    provenance, provenance_headers = _provenance(record)
    if payload.get("stream"):
        return StreamingResponse(
            _sse_events(payload, record, requested, provenance, started),
            media_type="text/event-stream",
            headers={
                **provenance_headers,
                "Cache-Control": "no-cache",
                "X-Accel-Buffering": "no",
            },
        )
    result = await engine.generate.remote.aio(payload, record)
    body = {
        "id": f"chatcmpl-{uuid.uuid4().hex}",
        "object": "chat.completion",
        "created": int(started),
        "model": requested,
        "choices": [
            {
                "index": 0,
                "message": {"role": "assistant", "content": result["text"]},
                "finish_reason": result.get("finish_reason") or "stop",
            }
        ],
        "usage": {
            "prompt_tokens": result.get("prompt_tokens") or 0,
            "completion_tokens": result.get("completion_tokens") or 0,
            "total_tokens": (result.get("prompt_tokens") or 0)
            + (result.get("completion_tokens") or 0),
        },
        "freesolo": provenance,
    }
    return JSONResponse(content=body, headers=provenance_headers)


@app.function(
    image=image,
    secrets=secrets,
    max_containers=1,
    timeout=TIMEOUT_SECONDS,
)
@modal.concurrent(max_inputs=100)
@modal.asgi_app()
def api():
    web = FastAPI(title=f"flash serving: {BASE_MODEL}")
    web.add_api_route("/healthz", healthz, methods=["GET"])
    web.add_api_route("/adapters", register_adapter, methods=["POST"], status_code=202)
    web.add_api_route("/adapters/{adapter_id:path}", get_adapter, methods=["GET"])
    web.add_api_route("/adapters/{adapter_id:path}", remove, methods=["DELETE"])
    web.add_api_route("/adapters/{revision_id:path}/activate", activate, methods=["POST"])
    web.add_api_route("/v1/chat/completions", chat_completions, methods=["POST"])
    return web
