# Flash self-hosted serving backend.
#
# Generated by `flash serve setup` -- this file is YOURS. It is a plain Modal app, not a vendored
# library, so read it and edit it. Regenerating overwrites it, so keep local changes in git.
#
# It implements the serving contract `flash models deploy` / `chat` / `undeploy` speak (see
# docs/serving-contract.md): five adapter endpoints plus an OpenAI-compatible chat route, serving
# one base model with many LoRA adapters on one GPU.
#
# Deploy:   modal deploy {app_file}
# Point flash at it:  export FREESOLO_SERVING_URL=<the url modal prints>
#
# Licensed under Apache-2.0, same as flash.
from __future__ import annotations

import asyncio
import contextlib
import hashlib
import hmac
import json
import math
import os
import re
import shutil
import time
import uuid
from typing import Any

import modal

# Imported at module scope, NOT inside the api() factory. `from __future__ import annotations`
# makes every annotation a string, and FastAPI resolves a handler's annotations against its
# MODULE globals: names visible only inside the factory cannot be resolved, so `request: Request`
# degrades into a required query parameter and every POST fails with a 422.
from fastapi import FastAPI, HTTPException, Request, Response, status
from fastapi.responses import JSONResponse, StreamingResponse

# ---------------------------------------------------------------------------------------------
# Configuration. Every value below came from the flash catalog entry for this base model, which
# records what Freesolo validated on real hardware for this exact model and card.
# ---------------------------------------------------------------------------------------------
APP_NAME = "{app_name}"
BASE_MODEL = "{base_model}"
GPU = "{gpu}"
# fp8 for dense models -- vLLM ONLINE-quantizes the public bf16 checkpoint at load, so no private
# pre-quantized repo is needed. None means "load the checkpoint as-is" (bf16).
QUANTIZATION = {quantization}
KV_CACHE_DTYPE = "{kv_cache_dtype}"
MAX_MODEL_LEN = {max_model_len}
MAX_NUM_SEQS = {max_num_seqs}
# 0 means "let vLLM pick". The catalog pins this only where the validated configuration depends
# on it -- the 35B MoE on H200 is memory-tight, and the scheduler/graph-capture footprint of
# vLLM's version-dependent default is not what was verified to fit.
MAX_NUM_BATCHED_TOKENS = {max_num_batched_tokens}
# vLLM PRE-ALLOCATES the GPU LoRA buffers at max_loras x max_lora_rank at engine init, NOT by how
# many adapters are actually loaded, so both are linear VRAM levers. Raising either can make a
# previously-fitting model fail to start. `flash serve gpus --model {base_model}` shows the cost.
MAX_LORAS = {max_loras}
MAX_LORA_RANK = {max_lora_rank}
GPU_MEMORY_UTILIZATION = {gpu_memory_utilization}
VLLM_VERSION = "{vllm_version}"

# Scale-to-zero: with no traffic Modal stops the container and you stop paying for the GPU. The
# tradeoff is a cold start on the next request (weights load + CUDA graph capture), so this is the
# knob to raise if cold starts hurt more than idle cost.
SCALEDOWN_WINDOW_SECONDS = {scaledown_window}
# Cold start on a large model is minutes, not seconds; the default startup timeout is too short.
STARTUP_TIMEOUT_SECONDS = 20 * 60
TIMEOUT_SECONDS = 30 * 60
# COLD STARTS AND THE DEPLOY BUDGET. flash's client waits 5 minutes for a revision to reach
# `ready` (REVISION_READY_BUDGET_SECONDS in flash/serve/deploy.py). A cold start plus a first
# adapter load can exceed that with NOTHING wrong, and `models deploy` then reports a timeout
# while the engine is healthy and still loading. That is the tradeoff of scale-to-zero: whichever
# deploy follows an idle period pays for the container start.
#
# It is recoverable rather than fatal, because registration is idempotent AND re-drives a load
# that never reached a terminal state -- re-running `flash models deploy` after such a timeout
# succeeds against the now-warm container. To never pay it, set `min_containers=1` below, which
# keeps the GPU resident and billed continuously.

CACHE_MOUNT = "/vol/flash-serving"
ADAPTER_DIR = f"{{CACHE_MOUNT}}/adapters"

image = (
    # A CUDA *devel* base, not debian_slim: vLLM's FlashInfer sampler JIT-COMPILES a kernel during
    # engine init, so the container needs `nvcc` and a toolchain at RUNTIME, not just at build time.
    # Without them init dies with "Could not find nvcc and default cuda_home='/usr/local/cuda'
    # doesn't exist" -- after the weights have loaded and the model has compiled, so it reads as a
    # mid-boot crash rather than a missing dependency. This is the image Freesolo runs in production.
    modal.Image.from_registry("nvidia/cuda:12.8.0-devel-ubuntu22.04", add_python="3.12")
    .apt_install("build-essential", "git", "ninja-build")
    .pip_install(
        f"vllm=={{VLLM_VERSION}}",
        "fastapi[standard]",
        "huggingface_hub[hf_transfer]",
        "transformers",
    )
    .env(
        {{
            "HF_HOME": CACHE_MOUNT,
            "HF_HUB_CACHE": f"{{CACHE_MOUNT}}/hub",
            # The HF Xet/CAS download path intermittently fails engine init with a body-decode
            # error and crash-loops the boot. The plain HTTP downloader is deterministic.
            "HF_HUB_DISABLE_XET": "1",
            "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
            # Let the CUDA allocator grow allocations instead of fragmenting into small blocks.
            # Multi-LoRA load/unload creates exactly that allocation pressure.
            "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
            # MoE only, and harmless elsewhere: keep the FP8 fused-MoE backend off the DeepGEMM
            # path, which crash-looped the MoE model in production. `auto` picks a working one.
            "VLLM_MOE_USE_DEEP_GEMM": "0",
        }}
    )
)

app = modal.App(APP_NAME, image=image)
cache_volume = modal.Volume.from_name(f"{{APP_NAME}}-cache", create_if_missing=True)
# Durable adapter records, so a registration survives a cold start and is visible to every
# container. Modal Dict entries are pickled values keyed by adapter id.
adapter_records = modal.Dict.from_name(f"{{APP_NAME}}-adapters", create_if_missing=True)

# Your HF token, for pulling the base model and your adapter repos:
#   modal secret create {secret_name} HF_TOKEN=hf_...
secrets = [modal.Secret.from_name("{secret_name}", required_keys=["HF_TOKEN"])]


def _utc_now() -> str:
    from datetime import UTC, datetime

    return datetime.now(UTC).isoformat()


def _adapter_digest(adapter_id: str) -> str:
    """A filesystem-safe, injective name for one adapter's cached files.

    Injective is the point. This used to be the 31-bit id below, which is a hash truncated to four
    bytes -- so two revisions colliding there also shared a download directory, and the second
    adapter's files silently overwrote the first's. A full digest has no such collision in practice,
    and the directory is then never the thing that aliases two adapters.
    """
    return hashlib.sha1(adapter_id.encode()).hexdigest()


def _lora_int_id(adapter_id: str) -> int:
    """A stable positive int32 id for one adapter, which is what vLLM's LoRARequest requires.

    vLLM demands an int, so 160 bits of digest have to become 31 -- collisions are possible in
    principle (birthday-bound around tens of thousands of live revisions). Rather than widen this,
    the engine keeps a reverse map and REFUSES a colliding load, because the failure mode of not
    noticing is serving one run's weights under another run's name.
    """
    digest = hashlib.sha1(adapter_id.encode()).digest()
    return (int.from_bytes(digest[:4], "big") & 0x7FFFFFFF) or 1


def _record_key(adapter_id: str) -> str:
    return f"record:{{adapter_id}}"


def _lock_key(name: str) -> str:
    return f"lock:{{name}}"


def _members_key(run_id: str) -> str:
    return f"members:{{run_id}}"


def _lora_id_key(int_id: int) -> str:
    return f"loraid:{{int_id}}"


# A full git commit sha, matching the `[0-9a-f]{{40}}` suffix flash's own revision-id grammar
# requires. Registration checks `metadata.hf_revision` against this because that value, not the id,
# is what gets downloaded.
_COMMIT_SHA_RE = re.compile(r"[0-9a-f]{{40}}")

# The immutable revision id flash builds: `<run_id>@final.<sha>` or `<run_id>@step-<N>.<sha>`.
# Mirrors `_ADAPTER_REVISION_RE` in flash/schema. The id is the identity, so the provenance a
# caller supplies alongside it has to AGREE with it rather than be trusted on its own.
_REVISION_ID_RE = re.compile(
    r"(?P<run_id>[A-Za-z0-9][A-Za-z0-9._-]{{0,127}})@"
    r"(?:final|step-(?P<step>0|[1-9]\d{{0,17}}))\.(?P<hf_revision>[0-9a-f]{{40}})"
)

# How many times to re-contest a LoRA id whose holder vanished mid-claim. See `_claim_lora_int_id`.
_CLAIM_ATTEMPTS = 3

# How many times undeploy re-reads a run's membership before answering. Each extra pass costs one
# indexed read and only happens when a registration landed during the previous one. See `remove`.
_UNDEPLOY_PASSES = 3


async def _claim_lora_int_id(int_id: int, adapter_id: str) -> str:
    """Claim ``int_id`` for ``adapter_id``, returning whichever adapter actually holds it.

    Shared rather than process-local because ``Engine`` scales horizontally: two colliding adapters
    settling on different containers would each find an empty local map and both load. And claimed
    before the download rather than after it, because the per-adapter lock does not serialize two
    DIFFERENT adapters -- checking first and recording minutes later leaves the entire download
    window open for the other one to pass the same check.

    ``put(skip_if_exists=True)`` is an atomic insert-if-absent, so exactly one adapter wins. A
    re-registration of the same adapter re-reads its own claim and proceeds, which keeps a retried
    load from being refused by its own earlier attempt.

    Looped, because insert and read are two calls and the owner can vanish between them: if the
    holder is undeployed in that gap the read returns None, and answering with the caller's own id
    would report a claim that was never recorded -- leaving the slot free for the old owner to
    re-register into while this adapter downloads, so both end up resident under one vLLM id. So a
    vacated slot is re-contested rather than assumed. Bounded rather than `while True`: each pass
    needs another adapter to have been undeployed in a specific window, so an unbounded loop could
    only ever spin on a Dict that is misbehaving.

    Exhausting the attempts RAISES rather than answering with the caller's own id. Answering looks
    conservative -- it lets a legitimate adapter proceed over a slot nobody holds -- but it hands
    back an ownership claim that was never recorded, which is the unclaimed-load path this function
    exists to remove: another colliding registration can take the id while this one downloads, and
    both end up resident under one vLLM id. A registration that fails loudly is recoverable by
    retrying; two adapters sharing an int id answers from the wrong run's weights and is not.
    """
    key = _lora_id_key(int_id)
    for _ in range(_CLAIM_ATTEMPTS):
        if await adapter_records.put.aio(key, adapter_id, skip_if_exists=True):
            return adapter_id
        owner = await adapter_records.get.aio(key)
        if owner is not None:
            return str(owner)
    raise RuntimeError(
        f"could not establish ownership of lora id {{int_id}} for {{adapter_id}} after "
        f"{{_CLAIM_ATTEMPTS}} attempts: the claim keeps being taken and released. retry the "
        f"deploy."
    )


async def _owns_lora_int_id(int_id: int, adapter_id: str) -> bool:
    """Whether ``adapter_id`` may evict ``int_id`` from the engine.

    Split from the release so eviction can happen while the claim is still HELD: the claim is what
    keeps a colliding newcomer out, and dropping it first lets that newcomer load into the id and
    then be evicted by this adapter's own `remove_lora`.

    An absent claim answers True for the same reason it does in `_release_lora_int_id`: the question
    is "would evicting kick a peer off the GPU", and with nothing recorded there is no peer.
    """
    owner = await adapter_records.get.aio(_lora_id_key(int_id))
    return owner is None or owner == adapter_id


async def _still_holds_lora_int_id(int_id: int, adapter_id: str) -> bool:
    """Whether ``adapter_id`` STILL holds the claim on ``int_id``.

    Deliberately not `_owns_lora_int_id`, which answers a different question. That one asks "would
    evicting kick a peer off the GPU" and so treats an absent claim as True. Here the question is
    "did this load keep the id it claimed", and an absent claim is a NO: the claim is taken before
    the download and released only by settle deciding this attempt failed, so finding it gone means
    this attempt was superseded and the id is free for a colliding adapter to take. Answering True
    there would leave the load resident holding nothing, which is exactly the unclaimed-resident
    state the claim exists to prevent.
    """
    owner = await adapter_records.get.aio(_lora_id_key(int_id))
    return owner == adapter_id


async def _release_lora_int_id(int_id: int, adapter_id: str) -> bool:
    """Drop ``adapter_id``'s claim on ``int_id``. False only when somebody ELSE holds it.

    `pop`-then-restore rather than read-then-delete, for the same reason as the run lock: `pop`
    returns what it removed, so what came back is proof of what was taken. An unconditional delete
    would let an undeploy of a REFUSED colliding adapter release the resident peer's claim.

    An ABSENT claim answers True, not False. The question this guard exists to ask is "would
    evicting kick a peer off the GPU", and with no claim recorded there is no peer -- a claim is
    taken before the download and released only by its owner, so a resident adapter always has one.
    Answering False there would skip the eviction for every adapter loaded before this app carried
    claims at all, leaving them resident against `max_loras` until the container restarts.

    A claim held by SOMEBODY ELSE returns without touching the key at all, and that early exit is
    load-bearing rather than an optimization. `pop` genuinely vacates the key before the restore
    puts it back, so on the non-owner path there is a window in which the id is unowned: a third
    colliding adapter can claim it there, the `skip_if_exists=True` restore then silently does
    nothing, and the resident owner has permanently lost its claim to an adapter that is not
    resident -- while still being resident itself. That is the wrong-run's-weights state the whole
    mechanism exists to prevent, and it was reachable from the ordinary undeploy of a REFUSED
    collider, which is the one caller guaranteed to hit the non-owner path.

    Reading first removes it: the only caller that vacated a peer's claim now never calls `pop`.
    The read is not a lock and does not pretend to be one -- an owner's own concurrent release can
    still change the answer -- but that case is one adapter releasing itself twice, which is
    idempotent, not two adapters trading a live claim.
    """
    key = _lora_id_key(int_id)
    owner = await adapter_records.get.aio(key)
    if owner is not None and owner != adapter_id:
        return False
    removed = await adapter_records.pop.aio(key, None)
    if removed is not None and removed != adapter_id:
        await adapter_records.put.aio(key, removed, skip_if_exists=True)
        return False
    return True


async def _engine_is_warm() -> bool:
    """Whether any Engine container is already running.

    Asked before any best-effort engine round trip, so an idle deployment does not cold-start a GPU
    just to remove an adapter that is not resident or delete files a CPU could not reach anyway.
    `num_total_runners` counts containers starting or running, which is the right question: one
    that is still booting will load the durable records, and those are already terminal by the time
    this is called.

    Fails CLOSED -- an unavailable stats call answers "not warm" and skips the call, which costs at
    most a `max_loras` slot on a live container until it recycles, or one cached directory until
    the next undeploy collects it. Answering "warm" instead would reinstate exactly the paid cold
    start this avoids.

    Module scope, not a closure inside `api()`. `settle_adapter` is a separate `@app.function` and
    could not see the nested version, so its cleanup call had no warm guard at all -- and its
    dominant failure case is an engine that never answered, i.e. exactly when nothing is warm.
    """
    try:
        stats = await Engine().unregister.get_current_stats.aio()
    except Exception:
        return False
    return bool(getattr(stats, "num_total_runners", 0))


async def _discard_cached_adapter(adapter_id: str) -> None:
    """Delete one revision's downloaded weights from the shared volume.

    Every immutable revision lands in its own digest directory, so a backend that serves successive
    checkpoints accumulates every one it has ever downloaded -- paid storage that grows without
    bound until the volume fills and no adapter can download at all.

    Gated on the DURABLE record still being disabled, re-read here rather than assumed. Callers
    hold at most a per-container lock, and the volume is shared by every replica, so a `models
    deploy` can re-register this exact revision and settle it `ready` while this runs. Deleting
    then removes the files out from under a live load on another container -- a `ready` record
    whose weights are gone, which fails at the next cold start rather than here. Re-registration is
    an explicit request that downloads the revision again, so a record that is no longer disabled
    is exactly the signal to leave the directory alone; the next undeploy collects it.

    RAISES when the delete fails, and that is the point: the caller decides what a failure means.
    Undeploy's deferred path keeps its `cache_reclaim_pending` marker so a later DELETE retries,
    which only works if the failure reaches it. Swallowing here (the old `suppress` plus
    `ignore_errors`) made every filesystem error -- a transient volume i/o fault, a permission
    problem -- look like a completed reclaim, so the marker was cleared for a directory that is
    still on disk and nothing would ever collect it. Callers that genuinely do not care still wrap
    the call; the difference is that they now choose to.
    """
    current = await adapter_records.get.aio(_record_key(adapter_id))
    if isinstance(current, dict) and current.get("status") == "disabled":
        # `ignore_errors` stays FALSE so a failed unlink surfaces. `missing_ok` behavior is kept by
        # tolerating an already-absent directory: a reclaim that ran before is a success, not an
        # error, and re-running one is exactly what a retried undeploy does.
        directory = f"{{ADAPTER_DIR}}/{{_adapter_digest(adapter_id)}}"
        if os.path.exists(directory):
            await asyncio.to_thread(shutil.rmtree, directory)


async def _mark_cache_reclaim_pending(adapter_id: str) -> None:
    """Flag a disabled revision's download for a later undeploy to collect.

    What every failed reclaim owes: the record is already `disabled` by the time a reclaim runs, and
    undeploy passes over disabled records, so a failure that leaves no marker leaves a directory
    nothing will ever collect. The marker is the only thing that puts it back in reach.

    Re-read under the run lock rather than written from a copy in hand, because the caller has
    usually already committed and released this record -- a blind put would undo whatever landed
    since. And only a record still `disabled` is marked: a revision re-registered in the meantime is
    using those files, and `_discard_cached_adapter` would refuse to delete them anyway, so marking
    it would only make a later cold undeploy do pointless work.
    """
    record = await adapter_records.get.aio(_record_key(adapter_id))
    if not isinstance(record, dict) or record.get("status") != "disabled":
        return
    run_id = (record.get("metadata") or {{}}).get("run_id") or adapter_id
    async with _run_lock(run_id):
        current = await adapter_records.get.aio(_record_key(adapter_id))
        if not isinstance(current, dict) or current.get("status") != "disabled":
            return
        current["metadata"] = {{
            **(current.get("metadata") or {{}}),
            "cache_reclaim_pending": True,
        }}
        await adapter_records.put.aio(_record_key(adapter_id), current)


async def _rebuild_run_members(run_id: str) -> list[str]:
    """Find a run's members by scanning, for when the index does not have them.

    The repair path for an index that is missing or predates this app version. Deliberately NOT
    called under the run lock: its cost tracks every adapter ever registered, and the lock's lease
    is a fixed TTL that cannot be renewed atomically (see `_run_lock`), so a scan inside it is the
    one thing that can push a critical section past its own expiry.

    Running it outside the lock makes it a snapshot, which is safe HERE and nowhere else: it only
    supplements the in-lock index read, and it only finds records the index missed -- records that
    predate the index or were orphaned by a dead container. A revision registered concurrently is
    added to the index under the lock, so the in-lock read is what catches it, not this.
    """
    found: list[str] = []
    async for key in adapter_records.keys.aio():
        if not isinstance(key, str) or not key.startswith("record:"):
            continue
        record = await adapter_records.get.aio(key)
        if not isinstance(record, dict):
            continue
        if (record.get("metadata") or {{}}).get("run_id") == run_id:
            found.append(record.get("adapter_id") or key[len("record:") :])
    return found


async def _run_members(run_id: str) -> list[str]:
    """Every adapter id belonging to one run: its alias plus each revision registered under it.

    An index rather than a scan. Undeploy needs the run's members, and finding them by walking the
    whole Dict costs time proportional to every adapter ever registered on the app -- under a lock
    whose TTL assumes bounded work. This keeps that cost proportional to the run.
    """
    members = await adapter_records.get.aio(_members_key(run_id))
    return list(members) if isinstance(members, list) else []


async def _remember_member(run_id: str, adapter_id: str) -> None:
    """Add one adapter id to its run's index, idempotently.

    Called only from inside the run lock, which is what makes the read-modify-write safe: the lock
    serializes every registration for a run, so no two writers race on this key.
    """
    members = await _run_members(run_id)
    if adapter_id not in members:
        await adapter_records.put.aio(_members_key(run_id), [*members, adapter_id])


# How long one held lock stays valid. Long enough for a record read-modify-write, short enough that
# a container killed mid-update does not wedge a run's alias forever.
#
# The TTL is a real bound, not a hope: everything inside a critical section here is a fixed, small
# number of Dict operations. Nothing slow may be added under this lock -- no adapter download, no
# engine call, no scan that grows with the number of adapters. That constraint is what makes the
# expiry safe, because renewing a lease cannot be done atomically on modal.Dict: `pop`-then-`put`
# vacates the key between the two calls, and a waiter can win `put(skip_if_exists=True)` in that
# gap and enter alongside the live holder. So the rule is to stay well inside the TTL rather than
# to extend it.
LOCK_TTL_SECONDS = 30.0


@contextlib.asynccontextmanager
async def _run_lock(run_id: str):
    """Serialize the read-modify-write on one run's records across containers.

    `alias_compare_and_swap` is a capability this app ADVERTISES, so it has to be real: without a
    mutual-exclusion primitive, two concurrent deploys of the same run can both read the same
    `previous`, both find their expectation satisfied, and both commit -- exactly the lost update
    the compare-and-swap exists to prevent.

    Modal's Dict offers no general compare-and-swap, but `put(skip_if_exists=True)` is an atomic
    insert-if-absent, which is enough to build one: whoever inserts the key holds the lock. The
    expiry stamp is what keeps a container that died mid-update from wedging the run forever.

    Every Dict call here uses `.aio`: this runs on the request event loop, and a blocking Modal
    call stalls every other request the container is serving concurrently, not just this one.
    """
    deadline = time.monotonic() + LOCK_TTL_SECONDS
    key = _lock_key(run_id)
    # An ownership token, not just an expiry. Two waiters can both observe the same stale lease,
    # and an unconditional delete would let the second one drop the FIRST one's freshly acquired
    # lease and then take its own -- putting both inside the critical section, which is exactly
    # the lost update `alias_compare_and_swap` promises cannot happen.
    token = uuid.uuid4().hex

    async def _drop_if(expected: Any) -> None:
        """Remove the lock only if it still holds `expected`, restoring it otherwise.

        Built on `pop`, not on read-then-delete: `pop` removes AND returns the value in one atomic
        step, so what came back is proof of what was removed. Read-then-delete cannot make that
        claim -- the value can change between the two calls, and the delete then destroys a lease
        the caller never inspected. That is the difference that matters when two waiters judge the
        same lease stale: the slower one's `pop` returns the winner's NEW lease, so it puts it back
        instead of clearing the slot and taking it.

        The restore is `skip_if_exists` so it can never overwrite a third holder that acquired in
        between; if it fails, that holder owns the lock and we leave it alone.

        What this does not close: `pop` is destructive, so between a misjudged removal and its
        restore the slot is briefly empty and a third waiter could win it. Closing that needs a
        compare-and-delete, which modal.Dict does not offer -- it is the usual result that a
        crash-recoverable lock cannot be built from insert-if-absent alone. It is reachable only
        when a holder has already died mid-update AND two more operations on the SAME run race
        through that window, and the run lock is a guard against the crashed-container case rather
        than the app's only defence. If you are running deploys concurrently enough to care, hold
        this state in a store with a real compare-and-swap.
        """
        removed = await adapter_records.pop.aio(key, None)
        if removed is not None and removed != expected:
            await adapter_records.put.aio(key, removed, skip_if_exists=True)

    while True:
        lease = {{"token": token, "expires_at": time.time() + LOCK_TTL_SECONDS}}
        # The ONLY way into the critical section: whoever wins this insert holds the lock. Never
        # by deleting somebody else's lease and assuming the slot is now ours.
        if await adapter_records.put.aio(key, lease, skip_if_exists=True):
            break
        holder = await adapter_records.get.aio(key)
        expires_at = holder.get("expires_at") if isinstance(holder, dict) else None
        # a stale lock (holder crashed) is reclaimed rather than waited on forever, but only the
        # exact lease that was judged stale -- and after reclaiming we still have to win the
        # insert above, so two waiters racing here cannot both end up inside.
        if not isinstance(expires_at, (int, float)) or expires_at < time.time():
            await _drop_if(holder)
            continue
        if time.monotonic() > deadline:
            # 409, not a 500: another operation on this run holds the lock, so this is contention
            # the caller can retry -- the same answer a stale compare-and-swap gets. A 5xx would
            # instead put the client on its ambiguous-failure path and make it retry a write it
            # cannot tell succeeded.
            raise HTTPException(
                status.HTTP_409_CONFLICT, f"another operation on {{run_id}} is in progress"
            )
        await asyncio.sleep(0.1)

    try:
        yield
    finally:
        await _drop_if(lease)


def _fingerprint(record: dict[str, Any]) -> tuple:
    """The identity an immutable revision promises never to change.

    Re-registering the same revision id with different content is a CONFLICT, not an update --
    that is what `immutable_adapter_revisions` means and why flash can trust a revision id to
    always name one artifact.
    """
    return (
        record.get("repo_id"),
        record.get("repo_type"),
        record.get("subfolder"),
        record.get("base_model"),
        record.get("checkpoint"),
        bool(record.get("thinking")),
        record.get("org_id") or None,
        # The client cross-checks this field on readback and treats a change as an immutability
        # violation, so it has to be part of identity here too: the same revision id serving a
        # different grammar is different content, not an update.
        record.get("structured_outputs") or None,
        # EVERY provenance field, not just the commit. The client cross-checks all three of these
        # on its 5xx recovery readback, so a re-registration that changes one is different content
        # by the client's own definition and must conflict. Registration additionally pins them to
        # the revision id, which catches the first registration too; this covers the comparison
        # itself, so a record that reached the store any other way is still compared on identity
        # rather than on the commit alone.
        *(
            (record.get("metadata") or {{}}).get(field)
            for field in ("run_id", "checkpoint_step", "hf_revision")
        ),
    )


# ---------------------------------------------------------------------------------------------
# The GPU engine: one vLLM instance holding the base model, serving many LoRA adapters.
# ---------------------------------------------------------------------------------------------
@app.cls(
    gpu=GPU,
    image=image,
    secrets=secrets,
    volumes={{CACHE_MOUNT: cache_volume}},
    scaledown_window=SCALEDOWN_WINDOW_SECONDS,
    startup_timeout=STARTUP_TIMEOUT_SECONDS,
    timeout=TIMEOUT_SECONDS,
)
@modal.concurrent(max_inputs=MAX_NUM_SEQS)
class Engine:
    @modal.enter()
    async def load(self) -> None:
        from transformers import AutoTokenizer
        from vllm import AsyncEngineArgs, AsyncLLMEngine

        # Per adapter, not one lock for the container. A first load downloads weights from HF and
        # calls add_lora, which takes minutes; a single lock would make every concurrent generation
        # on this container queue behind it -- including requests for adapters that are already
        # resident and merely need to READ this dict. One slow cold load would stall live traffic.
        self._locks: dict[str, asyncio.Lock] = {{}}
        self._loaded: dict[str, Any] = {{}}
        # int id -> the adapter that owns it, so a second adapter hashing to the same 31 bits is
        # refused instead of quietly taking over the first one's LoRA slot.
        self._int_ids: dict[int, str] = {{}}
        self.tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL, trust_remote_code=True)
        engine_args = AsyncEngineArgs(
            model=BASE_MODEL,
            quantization=QUANTIZATION,
            kv_cache_dtype=KV_CACHE_DTYPE,
            max_model_len=MAX_MODEL_LEN,
            max_num_seqs=MAX_NUM_SEQS,
            gpu_memory_utilization=GPU_MEMORY_UTILIZATION,
            enable_lora=True,
            max_loras=MAX_LORAS,
            max_lora_rank=MAX_LORA_RANK,
            trust_remote_code=True,
            **(
                {{"max_num_batched_tokens": MAX_NUM_BATCHED_TOKENS}}
                if MAX_NUM_BATCHED_TOKENS
                else {{}}
            ),
        )
        self.engine = AsyncLLMEngine.from_engine_args(engine_args)

    async def _adapter_path(self, record: dict[str, Any]) -> str:
        """Download the adapter to the shared volume and return its local path."""
        from huggingface_hub import snapshot_download

        adapter_id = record["adapter_id"]
        target = f"{{ADAPTER_DIR}}/{{_adapter_digest(adapter_id)}}"
        subfolder = record.get("subfolder") or ""
        pattern = f"{{subfolder}}/*" if subfolder else "*"
        path = await asyncio.to_thread(
            snapshot_download,
            repo_id=record["repo_id"],
            repo_type=record.get("repo_type") or "model",
            revision=(record.get("metadata") or {{}}).get("hf_revision") or None,
            allow_patterns=[pattern],
            local_dir=target,
            token=os.environ.get("HF_TOKEN"),
        )
        return f"{{path}}/{{subfolder}}" if subfolder else path

    async def _lora_request(self, record: dict[str, Any]):
        from vllm.lora.request import LoRARequest

        adapter_id = record["adapter_id"]
        # Fast path first, with no lock at all: a resident adapter is a plain dict read, and the
        # overwhelming majority of generate calls take this branch. Making them wait on a lock held
        # across somebody else's multi-minute download is what stalls live traffic.
        cached = self._loaded.get(adapter_id)
        if cached is not None:
            # Returned WITHOUT consulting the shared claim, which is correct for the traffic that
            # takes this branch and not correct for settle. See `_reclaim_lora_int_id`, which
            # `register` calls to close the difference.
            return cached
        # One lock PER adapter, so a cold load serializes only its own duplicate loads. asyncio has
        # no await between the get and the set below, so this is not racy on a single event loop.
        async with self._locks.setdefault(adapter_id, asyncio.Lock()):
            cached = self._loaded.get(adapter_id)
            if cached is not None:
                return cached
            int_id = _lora_int_id(adapter_id)
            # Refused, not resolved. vLLM addresses a LoRA solely by this int, so a collision would
            # make `add_lora` and `remove_lora` unable to tell the two apart and a chat could answer
            # from the wrong run's weights. There is no safe way to serve the second one, so the
            # registration fails loudly with the pair named -- deploying under a new run id is the
            # fix, and settle turns this into `failed` with this reason attached.
            #
            # Claimed in the shared Dict BEFORE the download, not in a local dict afterwards. Two
            # separate races made the local-and-late version unable to refuse anything:
            #   - the per-adapter lock does not serialize two DIFFERENT adapters, so both colliding
            #     loads passed the check, awaited their downloads, and both recorded ownership.
            #   - `Engine` scales horizontally, so two settles land on different containers whose
            #     process-local maps are both empty and both loads succeed.
            # `put(skip_if_exists=True)` is atomic across containers, so exactly one adapter wins
            # the id, and it wins before either has spent minutes downloading.
            owner = await _claim_lora_int_id(int_id, adapter_id)
            if owner == adapter_id:
                # Evict a stale local resident of this int id before loading over it. Undeploy's
                # eviction is one remote call and Modal routes it to ONE replica, so any other
                # replica that had served the old adapter still holds it under this int -- and
                # having released the claim, the id is legitimately re-claimable. Loading here
                # without evicting first would leave two adapters mapped to one int on this
                # container, which is precisely what vLLM cannot represent. Cheap: the map is
                # empty for this int on every replica that never served the old adapter.
                #
                # EVICT FIRST, CLEAR AFTER, and REFUSE TO LOAD if the eviction did not happen.
                # Suppressing the failure here was wrong in both halves: the maps were already
                # cleared, so the still-resident stale LoRA became untracked and no later sweep
                # could find it; and the load below then went ahead over an int id vLLM still has
                # bound to the old adapter. That `add_lora` typically fails, settle releases this
                # adapter's claim, and the id is free for the next collider to take -- with the
                # old weights still sitting under it, which is the wrong-run's-weights outcome the
                # whole claim mechanism exists to prevent. Keeping the maps costs one `max_loras`
                # slot on a container that is about to recycle, and leaves the resident adapter
                # findable so the next attempt's sweep can evict it properly.
                stale = self._int_ids.get(int_id)
                if stale is not None and stale != adapter_id:
                    try:
                        await self.engine.remove_lora(int_id)
                    except Exception as exc:
                        raise RuntimeError(
                            f"lora id {{int_id}} is still held by {{stale}} on this container and "
                            f"could not be evicted, so {{adapter_id}} cannot load over it: "
                            f"{{exc}}. retry the deploy."
                        ) from exc
                    self._loaded.pop(stale, None)
                    self._int_ids.pop(int_id, None)
            if owner != adapter_id:
                raise RuntimeError(
                    f"lora id collision: {{adapter_id}} and {{owner}} both hash to {{int_id}}, and "
                    f"vllm cannot tell them apart. redeploy under a different run id."
                )
            # NOT released here, even though this is where the failure happens. The claim is
            # global and keyed by adapter id, but a load is per-container: `Engine` scales
            # horizontally and a retried `models deploy` starts a second settle for the SAME
            # revision, so one container failing says nothing about whether another already has
            # the adapter resident. Releasing on the local failure pops the claim out from under
            # that live load, and the id is then free for a colliding adapter to take -- which is
            # the one outcome this whole mechanism exists to prevent, because vLLM addresses a
            # LoRA solely by the int and would answer from the wrong run's weights.
            #
            # `settle_adapter` releases instead: it runs under the run lock, and its
            # `settle_attempt` guard already decides which of several in-flight attempts is the
            # authoritative one. That is the only place that can tell "this revision failed" from
            # "this container's attempt at it failed".
            path = await self._adapter_path(record)
            request = LoRARequest(adapter_id, int_id, path)
            # Load it NOW rather than lazily on first generate: a bad adapter (wrong rank,
            # missing tensors) must fail here so registration reports `failed` with a real
            # reason, instead of reporting ready and then 500ing on the user's first chat.
            await self.engine.add_lora(request)
            # Ownership is re-checked AFTER the load, because the download takes minutes and the
            # claim can legitimately change hands inside that window: a retried deploy makes this
            # attempt superseded, and if the newer authoritative one then fails, settle releases
            # the claim while this load is still running. A colliding adapter can take the id from
            # there -- and this `add_lora` would land on top of it, two adapters under one vLLM
            # int. Losing the claim means this load must not stay resident, so it undoes itself
            # and reports the failure rather than leaving the engine in that state.
            if not await _still_holds_lora_int_id(int_id, adapter_id):
                # Recorded in `_int_ids` BEFORE the undo, and the undo is unconditional.
                #
                # Two earlier shapes were both wrong, in opposite directions, and the pair is why
                # this is written the way it is. Evicting unconditionally without recording can
                # kick a collider that already took the id off the GPU. Skipping the eviction when
                # a peer holds the claim leaves this container's just-loaded LoRA resident with no
                # `_int_ids` entry -- and the collision sweep above only consults `_int_ids`, so
                # the winner's own load cannot find the orphan and its `add_lora` fails on this
                # replica. Neither is fixable by reordering the checks: `self._locks` is keyed by
                # ADAPTER id while the contended resource is the INT id, so two colliding adapters
                # never serialize and the claim can change hands across any await here.
                #
                # So: evict unconditionally, and record the residency first so the eviction is
                # recoverable if it fails. A stale `_int_ids` entry is repairable -- the sweep
                # above finds it and evicts before loading over the id. A resident LoRA that
                # nothing recorded is not findable by anything.
                #
                # Evicting an id a collider has taken is the lesser harm of the two, and it is
                # self-correcting: the durable claim is atomic, so the winner still owns the id,
                # and its record stays `ready` while its next load re-adds the adapter. The
                # orphan has no such path back.
                self._int_ids[int_id] = adapter_id
                evicted = True
                try:
                    await self.engine.remove_lora(int_id)
                except Exception:  # best effort: the raise below reports the real failure
                    evicted = False
                # Cleared ONLY on a confirmed eviction. Popping unconditionally would undo the
                # line above for exactly the case it exists to cover: `remove_lora` failing leaves
                # the LoRA resident, and with no `_int_ids` entry nothing can find it again --
                # the orphan this ordering was written to prevent. Keeping the entry costs one
                # `max_loras` slot on a container that is about to recycle, and the collision
                # sweep repairs it by evicting before it loads over the id.
                if evicted:
                    self._int_ids.pop(int_id, None)
                self._loaded.pop(adapter_id, None)
                raise RuntimeError(
                    f"lora id {{int_id}} changed hands while {{adapter_id}} was loading, so this "
                    f"load was superseded. redeploy to retry."
                )
            self._loaded[adapter_id] = request
            self._int_ids[int_id] = adapter_id
            return request

    async def _reclaim_lora_int_id(self, adapter_id: str) -> None:
        """Re-establish the durable claim for an adapter this container already has resident.

        `_lora_request`'s cache hit is what makes this necessary, and the hit is not a bug: a
        generate against a resident adapter must not pay a Dict round trip. But a REGISTRATION that
        hits the cache is a different question, because `Engine` scales horizontally and undeploy's
        `unregister` is ONE remote call that Modal routes to ONE replica. So:

          - replicas A and B both have the revision resident,
          - undeploy lands on A, which evicts and releases the claim,
          - the run is redeployed and settle lands on B, which returns its cached entry.

        B never calls `_claim_lora_int_id`, so the record goes `ready` holding no claim -- and the
        claim is precisely what refuses a colliding revision. The next revision that hashes to the
        same 31 bits then takes the free id and loads, and two adapters that both read `ready`
        contend for one vLLM slot, which is the wrong-run's-weights outcome the claim exists to
        prevent.

        Re-claiming under the adapter's own lock, so this cannot race that adapter's own load. A
        LOST claim is fatal to the cached entry rather than to the caller's deploy alone: the id
        belongs to somebody else now, this container's resident copy is the intruder under it, and
        leaving it in `_loaded` would let the next generate answer from it. So the entry is dropped
        and the id evicted before raising, which puts this container back in the state a cold one
        would have been in -- the next settle re-downloads and re-contests honestly.
        """
        async with self._locks.setdefault(adapter_id, asyncio.Lock()):
            if self._loaded.get(adapter_id) is None:
                return  # evicted while we waited; the caller's load will claim normally
            int_id = _lora_int_id(adapter_id)
            owner = await _claim_lora_int_id(int_id, adapter_id)
            if owner == adapter_id:
                self._int_ids[int_id] = adapter_id
                return
            # EVICT FIRST, CLEAR ONLY ON CONFIRMATION -- the same ordering `_lora_request`'s stale
            # sweep uses, and for the same two reasons.
            #
            # Clearing `_int_ids` unconditionally was wrong in the case the entry exists for: if
            # `remove_lora` fails, adapter A is STILL resident under this int, and with no index
            # entry nothing can find it again. A later load of the winner B on this replica
            # consults `_int_ids`, sees nothing to evict, and calls `add_lora` over an id vLLM
            # still has bound to A -- which either fails or answers from A's weights under B's
            # revision. Keeping the entry costs one `max_loras` slot on a container that is about
            # to recycle, and leaves the orphan discoverable by the sweep that knows how to evict
            # it.
            #
            # NOT evicted here at all, and that is the fix rather than an omission. Guarding the
            # eviction by ownership was still wrong, because ownership can only be sampled BEFORE
            # the await: the winner B can finish its own sweep and `add_lora` while this
            # `remove_lora` is in flight, so the removal lands on B and a post-await recheck can
            # only decline to also delete B's index entry -- B is already off the GPU with its
            # record reading `ready`.
            #
            # Losing the claim means this id belongs to B, and evicting a resource this container
            # no longer owns is not this path's job. B's own stale sweep in `_lora_request` is what
            # evicts a leftover resident under a contended id, it is ownership-correct by
            # construction (it runs before B's load, holding the claim), and it RAISES rather than
            # loading over an eviction it could not confirm. Both reachable states are already
            # covered by it:
            #   - B has not swept yet: `_int_ids` still names this adapter, so B's sweep finds it
            #     and evicts before loading.
            #   - B has already swept: it evicted this adapter then, so there is nothing resident
            #     for this path to remove.
            #
            # So `_int_ids` is deliberately LEFT in place -- it is the breadcrumb B's sweep reads --
            # while `_loaded` is dropped, because this container must not serve an adapter whose
            # claim it has lost.
            self._loaded.pop(adapter_id, None)
            raise RuntimeError(
                f"lora id {{int_id}} is held by {{owner}}, so this container's cached copy of "
                f"{{adapter_id}} cannot be re-established. redeploy under a different run id."
            )

    @modal.method()
    async def register(self, record: dict[str, Any]) -> dict[str, Any]:
        try:
            # A registration that finds the adapter already resident must still hold the claim,
            # which the cache hit inside `_lora_request` skips. Ordered BEFORE the load so a
            # genuine miss claims exactly once, in the one place that downloads.
            if self._loaded.get(record["adapter_id"]) is not None:
                await self._reclaim_lora_int_id(record["adapter_id"])
            await self._lora_request(record)
        except Exception as exc:  # a real load failure, reported as such
            return {{"ok": False, "failure": f"{{type(exc).__name__}}: {{exc}}"}}
        return {{"ok": True}}

    @modal.method()
    async def unregister(self, adapter_id: str) -> dict[str, Any]:
        # This adapter's own lock, so an undeploy cannot race its own in-flight load, and does not
        # block loads or generations for any OTHER adapter on this container.
        async with self._locks.setdefault(adapter_id, asyncio.Lock()):
            self._loaded.pop(adapter_id, None)
            int_id = _lora_int_id(adapter_id)
            # Both the map entry and the eviction are conditional on THIS adapter owning the int
            # id, and they must stay that way together. vLLM addresses a LoRA only by the int, so
            # evicting unconditionally would drop whichever adapter currently holds it -- and for a
            # colliding revision that was REFUSED and never loaded, that means undeploying it kicks
            # the resident peer off the GPU while `_loaded` still reports the peer as present, so
            # it silently stops answering. Leaving the map entry alone matters for the same reason
            # in reverse: releasing it would hand the slot to the adapter the guard just refused.
            #
            # EVICT FIRST, RELEASE AFTER. The claim is what keeps a colliding newcomer out, and
            # the two adapters hold different per-adapter locks, so releasing first opens a window
            # in which the newcomer claims the id and loads -- and this `remove_lora(int_id)` then
            # evicts the NEWCOMER, whose record still says `ready` while nothing is resident.
            # Holding the claim across the eviction closes that window entirely.
            if await _owns_lora_int_id(int_id, adapter_id):
                self._int_ids.pop(int_id, None)
                # Drop it from vLLM too, not just from this dict. The LoRA cache is bounded by
                # max_loras, so repeated deploy/undeploy cycles would otherwise keep disabled
                # adapters resident until the container restarts and start evicting live ones.
                #
                # The claim is released ONLY on a confirmed eviction. `remove_lora` failing is
                # suppressed because it must never fail an undeploy, but suppressing it does not
                # make the adapter gone: it is still resident under this int id. Releasing anyway
                # would let a colliding adapter claim the id and load while the old weights still
                # occupy it, which is the wrong-run's-weights outcome the claim exists to prevent.
                # Keeping the claim instead costs one reserved id on a container that is about to
                # recycle, and the record is already `disabled` so nothing routes to it.
                evicted = True
                try:
                    await self.engine.remove_lora(int_id)
                except Exception:  # best effort, never fails an undeploy
                    evicted = False
                if evicted:
                    await _release_lora_int_id(int_id, adapter_id)
            # Suppressed HERE, not inside the helper: this is the eviction path, whose contract is
            # that it never fails an undeploy. But suppressing is not the same as forgetting -- a
            # failed `rmtree` leaves the download on the volume, and by this point the record is
            # already `disabled`, so no later DELETE pass revisits it and the directory is orphaned
            # for the life of the app. Every OTHER reclaim failure records the marker; this one is
            # reached from undeploy's warm branch, which is the ordinary path, so it needs it most.
            try:
                await _discard_cached_adapter(adapter_id)
            except Exception:
                # The same marker the cold path uses, so the next undeploy of this run collects it.
                with contextlib.suppress(Exception):  # marking is itself best effort
                    await _mark_cache_reclaim_pending(adapter_id)
        return {{"ok": True}}

    @modal.method()
    async def discard_cache(self, adapter_id: str) -> dict[str, Any]:
        """Reclaim a terminally-failed revision's download, without touching the GPU.

        Deliberately NOT `unregister`, which would be the obvious reuse. A load that failed left
        nothing resident to evict, and by the time settle calls this it has already released the
        int-id claim -- so `unregister`'s `_owns_lora_int_id` would read an absent claim, answer
        "no peer to disturb", and evict an id a colliding adapter may have taken and loaded into
        in that window. Cleanup has no reason to touch the engine at all.
        """
        await _discard_cached_adapter(adapter_id)
        return {{"ok": True}}

    async def _prepare(self, payload: dict[str, Any], record: dict[str, Any]):
        """Everything both generate paths need: the adapter, the prompt, and the sampling params.

        Shared so the streaming and one-shot routes cannot drift apart on the two things that are
        not the caller's to choose -- the adapter's trained thinking mode and the run's registered
        output grammar.
        """
        from vllm import SamplingParams

        lora_request = await self._lora_request(record)
        messages = payload.get("messages") or []
        kwargs = dict(payload.get("chat_template_kwargs") or {{}})
        # The adapter's trained thinking mode wins: a LoRA trained with thinking must render with
        # it, whatever the caller asked for, or the served output does not match the training.
        kwargs["enable_thinking"] = bool(record.get("thinking"))
        prompt_token_ids = await asyncio.to_thread(
            lambda: list(
                self.tokenizer.apply_chat_template(
                    messages,
                    tokenize=True,
                    add_generation_prompt=True,
                    return_dict=False,
                    **kwargs,
                )
            )
        )
        # The run's declared output contract, decided at registration and stored on the record --
        # not taken from the request, which must not be able to loosen it. Without this the
        # adapter serves unconstrained text while claiming to honour a JSON/regex/choice
        # constraint, and a plane's deployment smoke validates the constraint before activating.
        structured = record.get("structured_outputs") or None
        structured_params = None
        if isinstance(structured, dict) and any(
            structured.get(key) is not None for key in ("json", "regex", "choice", "json_object")
        ):
            from vllm.sampling_params import StructuredOutputsParams

            structured_params = StructuredOutputsParams(
                **{{k: v for k, v in structured.items() if v is not None}}
            )
        sampling = SamplingParams(
            # `or` fallbacks only reach an ABSENT field: an explicit value was range-checked at the
            # HTTP boundary, and both fallbacks equal the falsy value they would replace anyway.
            temperature=float(payload.get("temperature") or 0.0),
            # `or 512` only for an ABSENT field; an explicit value was validated at the boundary.
            max_tokens=int(payload.get("max_tokens") or 512),
            top_p=float(payload.get("top_p") or 1.0),
            stop=payload.get("stop") or None,
            structured_outputs=structured_params,
        )
        return prompt_token_ids, sampling, lora_request

    @modal.method()
    async def generate(self, payload: dict[str, Any], record: dict[str, Any]) -> dict[str, Any]:
        prompt_token_ids, sampling, lora_request = await self._prepare(payload, record)
        final = None
        async for out in self.engine.generate(
            {{"prompt_token_ids": prompt_token_ids}},
            sampling,
            str(uuid.uuid4()),
            lora_request=lora_request,
        ):
            final = out
        if final is None:
            raise RuntimeError("vLLM returned no output")
        completion = final.outputs[0]
        return {{
            "text": completion.text,
            "finish_reason": getattr(completion, "finish_reason", None),
            "prompt_tokens": len(getattr(final, "prompt_token_ids", None) or prompt_token_ids),
            "completion_tokens": len(getattr(completion, "token_ids", None) or []),
        }}

    @modal.method(is_generator=True)
    async def generate_stream(self, payload: dict[str, Any], record: dict[str, Any]):
        """Yield the completion in deltas, for `stream: true`.

        A SEPARATE method rather than a flag on `generate`: Modal decides generator-ness per
        function, and `.remote()` on a generator (or `.remote_gen()` on a non-generator) is an
        InvalidError, so one method cannot serve both shapes.

        vLLM's `generate` yields the CUMULATIVE text each step, but the OpenAI wire format carries
        per-chunk deltas -- forwarding vLLM's output directly would make every chunk repeat the
        whole answer so far, and a client that concatenates chunks would render the response
        quadratically duplicated.
        """
        prompt_token_ids, sampling, lora_request = await self._prepare(payload, record)
        sent = 0
        finish_reason = None
        async for out in self.engine.generate(
            {{"prompt_token_ids": prompt_token_ids}},
            sampling,
            str(uuid.uuid4()),
            lora_request=lora_request,
        ):
            completion = out.outputs[0]
            finish_reason = getattr(completion, "finish_reason", None)
            text = completion.text or ""
            if len(text) > sent:
                yield {{"delta": text[sent:], "finish_reason": None}}
                sent = len(text)
        # Always last, even for an empty generation: a client waits for a chunk carrying a finish
        # reason, so ending without one leaves it hanging on a stream that is already over.
        yield {{"delta": "", "finish_reason": finish_reason or "stop"}}


# ---------------------------------------------------------------------------------------------
# Registration settles here, off the web request, because loading weights takes minutes and the
# client polls for the result rather than holding the connection open.
#
# A separate Modal function rather than a background task in the web container: `api` scales
# horizontally and to zero, and an `asyncio` task belongs to one container's event loop. When that
# container goes away mid-load the task goes with it, no error is raised anywhere, and the record
# stays `registered` until the client gives up -- with the GPU idle and healthy the whole time.
# ---------------------------------------------------------------------------------------------
@app.function(
    image=image,
    secrets=secrets,
    volumes={{CACHE_MOUNT: cache_volume}},
    timeout=TIMEOUT_SECONDS,
)
async def reclaim_adapter_cache(adapter_id: str) -> dict[str, Any]:
    """Delete one revision's download from the volume, on a container with NO gpu.

    `Engine.discard_cache` does the same work, but `Engine` is declared `gpu=GPU` and its
    `@modal.enter` loads the base model into vLLM -- so calling it with everything scaled to zero
    boots a GPU container, waits out a multi-minute model load, and bills all of it, purely to run
    `rmtree`. That is self-defeating for the DEFERRED reclaim in particular, which exists precisely
    because the engine was cold and the fix was to avoid paying for a GPU start.

    Same volume, same durable re-check, no accelerator. `Engine.discard_cache` stays for the warm
    caller in `unregister`, where a container is already running and the round trip is free.
    """
    await _discard_cached_adapter(adapter_id)
    return {{"ok": True}}


@app.function(image=image, secrets=secrets, timeout=TIMEOUT_SECONDS)
async def settle_adapter(record: dict[str, Any]) -> None:
    """Load one adapter onto the engine, then write the lifecycle state the client waits on."""
    adapter_id = record["adapter_id"]
    metadata = record.get("metadata") or {{}}
    attempt = metadata.get("settle_attempt")
    run_id = metadata.get("run_id") or adapter_id
    # The RPC ITSELF is caught, not just the load inside it. A container that dies during startup,
    # a timeout, or any Modal-side failure raises here, outside `Engine.register`'s own handler --
    # and settle runs detached, so nothing observes that raise. The record then stays `registered`
    # forever, the client polls it for its full readiness budget, and the deploy reports a timeout
    # that reads as a slow GPU rather than as an engine that never answered. Turned into the same
    # failure envelope a load error produces, so the commit below records it as `failed`.
    try:
        result = await Engine().register.remote.aio(record)
    except Exception as exc:
        result = {{"ok": False, "failure": f"the serving engine did not answer: {{exc}}"}}
    stand_down = False
    discard_cache = False
    # Sampled BEFORE the lock, because the commit inside it has to record whether the reclaim can
    # happen now or must be deferred, and an engine round trip is exactly what must not run under
    # a lock whose TTL depends on nothing slow happening.
    engine_warm = await _engine_is_warm()
    # The load ran OUTSIDE the lock -- it takes minutes, and the lock's TTL only holds because
    # nothing slow runs under it. But the decision of whether this result may be committed, and
    # the commit itself, must be one atomic step: read-then-write leaves a window in which an
    # undeploy or a retried registration lands between them, and this write then silently
    # overwrites that newer state (resurrecting an undeployed revision, or replacing the current
    # attempt's result with a stale one). Everything below is a small fixed number of Dict calls.
    async with _run_lock(run_id):
        current = (await adapter_records.get.aio(_record_key(adapter_id))) or record
        current_metadata = current.get("metadata") or {{}}
        # An undeploy that lands while the load is still running wins. Without this, a slow load
        # finishing after DELETE would write `ready` back over `disabled` and resurrect a revision
        # the user already took out of service -- and it could then be activated again.
        if (
            current.get("status") == "disabled"
            and current_metadata.get("lifecycle_state") == "disabled"
        ):
            stand_down = True
        # Only the CURRENT attempt may write a terminal state. A user who retries `models deploy`
        # after the client's readiness budget expires re-registers while the first load is still
        # running, so two settles for one revision are in flight on different containers and finish
        # in any order. Unguarded, a stale transient failure lands after a fresh success and pins
        # the record to `failed`, which an identical re-registration then treats as a state to reset
        # rather than a load to retry.
        elif attempt is None or current_metadata.get("settle_attempt") == attempt:
            if result.get("ok"):
                current["status"] = "ready"
                current["metadata"] = {{**current_metadata, "lifecycle_state": "ready"}}
            else:
                current["status"] = "disabled"
                current["metadata"] = {{
                    **current_metadata,
                    "lifecycle_state": "failed",
                    "failure": result.get("failure"),
                }}
                # A FAILED load's claim is released here, not in the engine. The load runs
                # per-container and cannot tell its own failure from the revision's: a retried
                # deploy has a second settle in flight for the same adapter, possibly already
                # resident on another container. This branch is the one place that knows better --
                # it holds the run lock, and reaching it means this attempt is the authoritative
                # one AND its load failed, so the revision really is going terminal and its id
                # must not stay reserved. Otherwise the claim outlives its adapter permanently:
                # undeploy skips already-disabled records, and the id is a hash of the adapter id,
                # so a retry cannot get a different one.
                await _release_lora_int_id(_lora_int_id(adapter_id), adapter_id)
                discard_cache = True
                # The reclaim itself runs after the lock, but whether it CAN run now is known
                # here, and the deferral has to be recorded in this same write. Undeploy passes
                # over records that are already `disabled` -- which this branch just made it --
                # so a marker written separately afterwards could be lost to an interleaving
                # write, and nothing would ever collect the directory.
                if not engine_warm:
                    current["metadata"] = {{
                        **current["metadata"],
                        "cache_reclaim_pending": True,
                    }}
            current["updated_at"] = _utc_now()
            await adapter_records.put.aio(_record_key(adapter_id), current)
    # Outside the lock: an engine round trip is slow, and the record is already durably correct.
    if stand_down:
        with contextlib.suppress(Exception):  # gpu eviction is best effort
            await Engine().unregister.remote.aio(adapter_id)
    # A revision whose load failed terminally still has its download on the volume: `_adapter_path`
    # runs before `add_lora`, so a rejected adapter (wrong rank, missing tensors) is one that
    # downloaded fine and then failed to load. Nothing else ever collects it -- DELETE skips
    # records that are already `disabled`, and this branch just made it so -- and the id is a hash
    # of the adapter id, so each distinct bad revision leaves its own directory behind forever.
    # Best effort and last: the record is already durably `failed`, which is what the client is
    # polling for, and reclaiming disk must not turn a reported failure into an unreported one.
    #
    # Gated on a WARM engine, like undeploy's eviction. The volume is only reachable from a
    # container that mounts it, so with everything scaled to zero this call would boot a GPU --
    # minutes of paid time, billed against a deploy that already failed -- purely to run `rmtree`.
    # And the common path here is `register.remote` itself failing because no container could
    # start, which is exactly when nothing is warm, so the unguarded version turned every engine
    # outage into a paid cold start per failed registration.
    #
    # Skipping DEFERS the reclaim, it does not cancel it, and the deferral has to be recorded to
    # be real: this settle already marked the record `disabled`, and undeploy passes over records
    # that are already disabled, so without a marker nothing would ever collect the directory and
    # every cold failed load would leak its download onto the volume permanently. The flag is what
    # undeploy looks for.
    if discard_cache and engine_warm:
        try:
            await Engine().discard_cache.remote.aio(adapter_id)
        except Exception:
            # Falls back to the SAME deferral the cold path uses. Previously suppressed outright,
            # which was the one case with no retry anywhere: the cold path at least leaves a marker,
            # while a warm reclaim that failed -- a volume i/o fault, the container recycling
            # mid-call -- was simply forgotten, and undeploy skips the record because this settle
            # already made it `disabled`. Marking it means the run's DELETE collects it later.
            with contextlib.suppress(Exception):  # marking is itself best effort
                await _mark_cache_reclaim_pending(adapter_id)


# ---------------------------------------------------------------------------------------------
# The HTTP front door: the contract flash speaks. Runs on CPU and is the only public surface --
# vLLM itself is never exposed, so nothing outside can ask the engine to load an arbitrary path.
# ---------------------------------------------------------------------------------------------
@app.function(image=image, secrets=secrets, timeout=TIMEOUT_SECONDS)
@modal.concurrent(max_inputs=100)
@modal.asgi_app()
def api():
    web = FastAPI(title=f"flash serving: {{BASE_MODEL}}")
    engine = Engine()

    async def _spawn_settle(record: dict[str, Any], holds_lock: bool = False) -> None:
        """Hand the load to a worker, marking the record `failed` if the handoff itself fails.

        A raise here would otherwise return 500 over a durable record still reading `registered` --
        and the client's ambiguous-registration recovery re-reads that record, sees a matching
        identity, concludes the registration DID land, and polls it for the full five-minute
        readiness budget instead of repeating the idempotent POST. The deploy then fails as a
        timeout, which reads as a slow GPU rather than as a queue that never accepted the work.

        `failed` is the honest terminal state and the useful one: it is what the client treats as a
        real failure, and re-registering is what clears it, so the operator's natural next move is
        the one that fixes it.

        Written only when the durable record still carries THIS request's attempt token. Two
        identical registrations overlap by design -- the second stamps a new `settle_attempt` and
        queues its own settle -- so an unconditional write here would restore this request's stale
        record as `failed` over the newer one, and the live settle would then find a token mismatch
        and be unable to commit its result at all. The run whose load actually succeeds would sit
        at `failed` permanently.

        The check and the write are ONE critical section, taken under the run lock unless the caller
        already holds it (`holds_lock`, which the identical-registration path passes -- acquiring it
        again there would deadlock against itself). Read and write as separate awaits, an identical
        registration landing between them stamps a new `settle_attempt` and queues its own settle,
        and this stale `failed` record then lands on top: the newer POST has already returned
        success, but the settle it spawned finds its token gone and can never commit `ready`. So an
        accepted registration sits at `failed` forever, which is exactly the outcome the token check
        was written to prevent -- it just could not see a writer that arrived after its read.
        """
        try:
            settle_adapter.spawn(record)
        except Exception as exc:

            async def _commit_failure() -> None:
                attempt = (record.get("metadata") or {{}}).get("settle_attempt")
                current = await _read(record["adapter_id"])
                if attempt is not None and isinstance(current, dict):
                    if (current.get("metadata") or {{}}).get("settle_attempt") != attempt:
                        raise
                record["status"] = "failed"
                record["metadata"] = {{
                    **(record.get("metadata") or {{}}),
                    "lifecycle_state": "failed",
                    "failure": f"could not enqueue the adapter load: {{exc}}",
                }}
                await _write(record)

            if holds_lock:
                await _commit_failure()
            else:
                # From the record, not a closure: this helper is called for revisions and for the
                # alias, and `metadata.run_id` is the same value the registration path locked on.
                settle_run = (record.get("metadata") or {{}}).get("run_id") or record["adapter_id"]
                async with _run_lock(settle_run):
                    await _commit_failure()
            raise

    def _require_key(request: Request) -> None:
        """Authenticate the caller when a key is configured.

        FLASH_SERVING_KEY is optional but strongly recommended: without it, anyone who finds this
        URL can register adapters and spend your GPU budget. flash sends the value of
        FREESOLO_INTERNAL_KEY in this header.

        Both sides are STRIPPED, and they have to agree on that. The client strips before building
        the header (`flash/serve/urls.py:internal_key_header`), so a secret stored with surrounding
        whitespace -- which is easy to produce, since a shell heredoc or a copied line carries a
        trailing newline -- makes the operator supply the identical raw value on both sides and get
        a 401 on every request, while `/healthz` cheerfully reports `requires_key: true`. Stripping
        here is not a weakening: a key that differs only in surrounding whitespace is the same key,
        and the comparison stays constant-time over the normalized values.
        """
        expected = (os.environ.get("FLASH_SERVING_KEY") or "").strip()
        if not expected:
            return
        presented = (request.headers.get("X-Freesolo-Internal-Key") or "").strip()
        # constant time, so a wrong key cannot be discovered one character at a time
        if not hmac.compare_digest(presented, expected):
            raise HTTPException(status.HTTP_401_UNAUTHORIZED, "invalid serving key")

    # async, and `.aio` throughout: these run on the request event loop with up to 100 requests in
    # flight per container, so a blocking Modal round trip stalls all of them, not just this one.
    async def _read(adapter_id: str) -> dict[str, Any] | None:
        return await adapter_records.get.aio(_record_key(adapter_id))

    async def _write(record: dict[str, Any]) -> None:
        record["updated_at"] = _utc_now()
        await adapter_records.put.aio(_record_key(record["adapter_id"]), record)

    async def _ensure_run_alias(run_id: str, revision_id: str) -> None:
        """Make sure the run's alias and member index exist. Idempotent, and called on every
        registration for the run rather than only the first.

        The alias starts `disabled` and points at nothing: activation is what makes a run serve, so
        a half-finished deploy never takes traffic. Repairing rather than creating-once is what
        makes an interrupted first registration recoverable -- see the caller.

        Runs under the run lock, which is what makes the index's read-modify-write safe.
        """
        if await _read(run_id) is None:
            await _write(
                {{
                    "adapter_id": run_id,
                    "base_model": BASE_MODEL,
                    "status": "disabled",
                    "metadata": {{"record_type": "alias", "run_id": run_id, "alias_of": None}},
                }}
            )
        await _remember_member(run_id, run_id)
        await _remember_member(run_id, revision_id)

    @web.get("/healthz")
    async def healthz() -> dict[str, Any]:
        return {{
            "ok": True,
            "base_models": [BASE_MODEL],
            "gpu": GPU,
            # Whether this app authenticates writes at all. Deliberately not the key itself, and
            # not a per-request answer: `flash serve setup` reads it once after deploying to warn
            # about a URL that anyone could register adapters against.
            # Stripped, matching `_require_key`: a whitespace-only value authenticates nothing, so
            # reporting `true` for it would tell `flash serve setup` the URL is guarded when it is
            # wide open -- suppressing the one warning that would have caught it.
            "requires_key": bool((os.environ.get("FLASH_SERVING_KEY") or "").strip()),
            # Only what this backend genuinely implements. `revision_provenance` is advertised
            # because the records below echo the run/checkpoint/hf_revision metadata back.
            # thinking_structured_outputs_deferred_v1 is NOT advertised: deferring a grammar until
            # after </think> is not implemented here, and advertising it would let flash deploy a
            # thinking+structured-output adapter that then serves invalid output.
            "capabilities": [
                "immutable_adapter_revisions",
                "alias_compare_and_swap",
                "revision_provenance",
            ],
        }}

    @web.post("/adapters", status_code=status.HTTP_202_ACCEPTED)
    async def register_adapter(payload: dict[str, Any], request: Request) -> dict[str, Any]:
        _require_key(request)
        adapter_id = str(payload.get("adapter_id") or "").strip()
        # Type-checked, not just defaulted. `or {{}}` substitutes only the FALSY cases, so a truthy
        # non-object -- a bare string, a nonempty list -- came through intact and the `.get` below
        # raised AttributeError, answering 500 for a malformed body this endpoint already knows how
        # to reject. That distinction is not cosmetic to the caller: the client treats 5xx as an
        # ambiguous failure and retries after re-reading the record, while a 422 tells it the
        # payload is wrong and to stop.
        metadata = payload.get("metadata")
        if metadata is None:
            metadata = {{}}
        if not isinstance(metadata, dict):
            raise HTTPException(
                status.HTTP_422_UNPROCESSABLE_ENTITY,
                f"metadata must be an object, got {{type(metadata).__name__}}",
            )
        run_id = str(metadata.get("run_id") or "").strip()
        if not adapter_id or not run_id:
            raise HTTPException(status.HTTP_422_UNPROCESSABLE_ENTITY, "adapter_id and run_id are required")
        if payload.get("base_model") != BASE_MODEL:
            raise HTTPException(
                status.HTTP_409_CONFLICT,
                f"this app serves {{BASE_MODEL}}, not {{payload.get('base_model')}}",
            )
        # The ID IS THE IDENTITY, so the provenance sent alongside it must agree with it. Checked
        # against the id rather than merely stored, because these fields are load-bearing in three
        # separate ways and none of them can be repaired after the fact:
        #
        #   - `hf_revision` is what `_adapter_path` hands to `snapshot_download`. A branch name
        #     like `main` makes one immutable id serve whatever that branch points at today.
        #   - `run_id` decides which run's alias and membership this revision joins, so a mismatch
        #     files this artifact under a DIFFERENT run -- and undeploying that run then reports
        #     success while this revision keeps serving under its own id.
        #   - `checkpoint_step` is echoed back as provenance, which the client cross-checks on its
        #     5xx recovery path against a backend advertising `revision_provenance`.
        #
        # Comparing them to the id closes all three at once, and it works on the FIRST
        # registration -- widening `_fingerprint` alone only catches the second one, by which time
        # the alias has already been written to the wrong run.
        parsed = _REVISION_ID_RE.fullmatch(adapter_id)
        if parsed is None:
            raise HTTPException(
                status.HTTP_422_UNPROCESSABLE_ENTITY,
                f"adapter_id {{adapter_id!r}} is not an immutable revision id "
                f"(<run_id>@final.<40-hex sha> or <run_id>@step-<N>.<40-hex sha>)",
            )
        expected_step = parsed.group("step")
        supplied_step = metadata.get("checkpoint_step")
        # Coerced defensively: `int()` on a caller-supplied value raises TypeError/ValueError for a
        # string or a dict, and an uncaught raise here is a 500 for what is a malformed REQUEST.
        # An uncoercible value can never equal the parsed step, so it falls into `mismatched` and
        # is reported as the 422 it is.
        if supplied_step is not None:
            try:
                supplied_step = int(supplied_step)
            except (TypeError, ValueError):
                supplied_step = repr(supplied_step)
        mismatched = [
            f"{{name}}={{supplied!r}} (id says {{expected!r}})"
            for name, supplied, expected in (
                ("run_id", run_id, parsed.group("run_id")),
                ("hf_revision", str(metadata.get("hf_revision") or "").strip(), parsed.group("hf_revision")),
                (
                    "checkpoint_step",
                    supplied_step,
                    None if expected_step is None else int(expected_step),
                ),
            )
            if supplied != expected
        ]
        if mismatched:
            raise HTTPException(
                status.HTTP_422_UNPROCESSABLE_ENTITY,
                f"metadata disagrees with the revision id {{adapter_id}}: {{', '.join(mismatched)}}",
            )
        record = {{
            "adapter_id": adapter_id,
            "repo_id": payload.get("repo_id"),
            "repo_type": payload.get("repo_type") or "model",
            "subfolder": payload.get("subfolder"),
            "base_model": payload.get("base_model"),
            "checkpoint": payload.get("checkpoint"),
            "thinking": bool(payload.get("thinking")),
            "org_id": payload.get("org_id"),
            "structured_outputs": payload.get("structured_outputs"),
            "status": "registered",
            # record_type is written AFTER the caller's metadata, not before it. This endpoint
            # registers revisions and nothing else, so the value is ours to state. Merged in
            # front, a caller sending `record_type: "alias"` overrode it and produced a record
            # that loads onto the GPU but can never be activated (`/activate` refuses non
            # revisions) and is misclassified by undeploy as an alias, so it skips both eviction
            # and cache cleanup -- and an identical retry cannot repair it, because `_fingerprint`
            # does not cover `record_type`.
            "metadata": {{
                **metadata,
                # The NORMALIZED sha, not the caller's original. The agreement check above strips
                # before comparing, so `" abc... "` is accepted as matching the id -- but storing
                # the raw value then hands that padded string to `snapshot_download(revision=...)`,
                # which fails to resolve an otherwise valid commit, and an ambiguous-registration
                # readback disagrees with the client's canonical sha. Stripping here rather than
                # rejecting keeps the tolerance the comparison already grants, and makes the stored
                # record say the same thing the id does.
                "hf_revision": str(metadata.get("hf_revision") or "").strip() or None,
                "record_type": "revision",
                "lifecycle_state": "registered",
            }},
        }}
        async with _run_lock(run_id):
            existing = await _read(adapter_id)
            if existing is not None:
                # Immutability: same id, same content is a no-op; same id, different content is a
                # conflict. Never an overwrite.
                if _fingerprint(existing) != _fingerprint(record):
                    raise HTTPException(
                        status.HTTP_409_CONFLICT, "immutable adapter revision already exists"
                    )
                # Same id, same content. `ready` is a genuine no-op. The other two states are not:
                #
                # `registered` means the first settle never reached a terminal state. Retrying
                # after an ambiguous failure is exactly how the client recovers, so re-drive it
                # rather than stranding the revision there forever.
                #
                # `disabled`/`failed` means undeploy (or a failed load) already ran. A revision id
                # is deterministic in (run_id, step, hf_revision), so redeploying an UNCHANGED
                # checkpoint arrives here with the same id -- and returning the disabled record
                # would make the client raise a readiness failure, permanently. An explicit
                # registration is a deliberate request to serve this artifact again, so it resets
                # the record to `registered` and loads it afresh.
                #
                # This is safe precisely because it requires a fresh POST: a late settle finishing
                # after an undeploy carries no registration behind it, and still stands down.
                state = (existing.get("metadata") or {{}}).get("lifecycle_state")
                if state != "ready":
                    existing["status"] = "registered"
                    existing["metadata"] = {{
                        **(existing.get("metadata") or {{}}),
                        "lifecycle_state": "registered",
                        # A new attempt id retires whatever settle is still running for this
                        # revision: it stops the older one writing a terminal state over this one's.
                        "settle_attempt": uuid.uuid4().hex,
                    }}
                    # Drop a stale failure reason so a retried load does not report the old one.
                    existing["metadata"].pop("failure", None)
                    # And the deferred reclaim it was paired with. The marker means "this
                    # revision's download is garbage waiting to be collected", which stops being
                    # true the moment the revision is registered again -- `_discard_cached_adapter`
                    # would refuse to delete the files anyway, so a surviving marker only makes a
                    # later cold undeploy boot a GPU to reclaim a directory that is still in use.
                    existing["metadata"].pop("cache_reclaim_pending", None)
                    await _write(existing)
                # Repaired on EVERY registration, including the `ready` no-op, not only on the
                # first. Registration writes the revision and the alias as two operations, so a
                # container that died between them leaves a revision whose run has no alias. Every
                # retry then took the identical-registration path and returned before reaching the
                # alias creation below, so the revision could reach `ready` while activation failed
                # forever with "run alias is missing" -- a run permanently undeployable, recoverable
                # only by a new artifact.
                await _ensure_run_alias(run_id, adapter_id)
                if state != "ready":
                    # Already inside `_run_lock(run_id)`, so the failure commit must not retake it.
                    await _spawn_settle(existing, holds_lock=True)
                return {{"ok": True, "adapter": existing}}
            record["metadata"]["settle_attempt"] = uuid.uuid4().hex
            # Indexed BEFORE the record is written, and the order is the whole point.
            #
            # These are two Dict operations and a container can die between them, so one of the
            # two states is going to be reachable. Written first, the surviving state is a record
            # that its run's index does not name -- an orphan undeploy cannot reach, which stays
            # `ready`, resident on the GPU, and directly callable by its immutable id after DELETE
            # answered 200. Indexed first, the surviving state is an index naming a record that
            # does not exist, which the disable loop skips (`_read` returns None) and the next
            # registration completes. One direction loses an adapter, the other costs a wasted
            # lookup, so the write order is what makes undeploy's membership sound.
            #
            # Detecting the bad state instead was the alternative, and it is not available: knowing
            # a NONEMPTY index is missing a revision means enumerating that run's revisions, which
            # is the unbounded keyspace scan the lock's non-renewable TTL cannot afford.
            await _remember_member(run_id, adapter_id)
            await _write(record)
            await _ensure_run_alias(run_id, adapter_id)

        # Spawned, NOT `asyncio.create_task`: this web function scales horizontally and to zero, so a
        # task parked in one container's event loop dies with that container -- and because the very
        # next poll is load balanced to a different replica, nothing is left to notice. The record
        # then sits in `registered` forever and the deploy times out with the GPU perfectly healthy.
        # `spawn` hands the work to Modal, which runs it server-side and survives the response.
        await _spawn_settle(record)
        return {{"ok": True, "adapter": record}}

    @web.get("/adapters/{{adapter_id:path}}")
    async def get_adapter(adapter_id: str, request: Request, response: Response) -> dict[str, Any]:
        _require_key(request)
        record = await _read(adapter_id)
        if record is None:
            raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter id")
        state = (record.get("metadata") or {{}}).get("lifecycle_state")
        if state == "registered":
            # Tell the client how long to wait instead of making it guess: it honors Retry-After.
            response.headers["Retry-After"] = "2"
        return {{"ok": True, "adapter": record}}

    @web.post("/adapters/{{revision_id:path}}/activate")
    async def activate(revision_id: str, payload: dict[str, Any], request: Request) -> dict[str, Any]:
        _require_key(request)
        revision = await _read(revision_id)
        if revision is None or (revision.get("metadata") or {{}}).get("record_type") != "revision":
            raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter revision")
        if revision.get("status") != "ready":
            raise HTTPException(status.HTTP_409_CONFLICT, "adapter revision is not ready")
        run_id = (revision.get("metadata") or {{}}).get("run_id")
        # The compare and the swap must be ONE atomic step. Reading `previous`, checking it, then
        # writing is a lost-update race: two deploys of the same run both read the same previous,
        # both pass the check, and the second silently overwrites the first.
        async with _run_lock(run_id):
            # Re-read the REVISION inside the lock, not just the alias. The readiness check above
            # ran outside it, so an undeploy can disable both records in between -- and because
            # undeploy leaves the alias `disabled`, `previous` collapses to None and a first
            # activation's `expected_adapter_revision: null` still matches. The alias would then be
            # written back to `ready` pointing at a revision that is disabled and evicted from the
            # GPU: a successful activation that can never serve a request.
            revision = await _read(revision_id)
            if revision is None or revision.get("status") != "ready":
                raise HTTPException(status.HTTP_409_CONFLICT, "adapter revision is not ready")
            alias = await _read(run_id)
            if alias is None:
                raise HTTPException(status.HTTP_409_CONFLICT, "run alias is missing")
            previous = (
                None
                if alias.get("status") == "disabled"
                else (alias.get("metadata") or {{}}).get("alias_of")
            )
            expected = payload.get("expected_adapter_revision")
            if expected != previous:
                raise HTTPException(status.HTTP_409_CONFLICT, "stale adapter revision expectation")
            alias["status"] = "ready"
            alias["metadata"] = {{
                "record_type": "alias",
                "run_id": run_id,
                "alias_of": revision_id,
            }}
            await _write(alias)
        return {{
            "adapter_id": run_id,
            "target_adapter_revision": revision_id,
            "previous_adapter_revision": previous,
            "checkpoint": revision.get("checkpoint"),
            "updated_at": alias["updated_at"],
        }}

    @web.delete("/adapters/{{adapter_id:path}}")
    async def remove(adapter_id: str, request: Request) -> dict[str, Any]:
        _require_key(request)
        record = await _read(adapter_id)
        if record is None:
            raise HTTPException(status.HTTP_404_NOT_FOUND, "unknown adapter id")
        run_id = (record.get("metadata") or {{}}).get("run_id") or adapter_id
        disabled_aliases: list[str] = []
        disabled_revisions: list[str] = []
        # Revisions whose download a cold settle deliberately left on the volume. Not part of the
        # response: they were disabled by an earlier call, so reporting them here would tell the
        # client this undeploy disabled something it did not.
        reclaimable: list[str] = []
        # Repair BEFORE the lock, because the scan is unbounded and the lease is not renewable.
        #
        # Unioning `adapter_id` into the members below is not enough on its own: flash's client
        # always deletes by RUN id (`undeploy_adapter` builds the url from run_id), so on the real
        # path `adapter_id == run_id` and the union adds nothing. With no index, the loop would
        # then disable the alias alone and leave every sibling revision `ready`, resident on the
        # GPU, and reactivatable -- undeploy answering 200 for a run that still serves.
        #
        # Emptiness is the whole trigger, and that is sound only because registration indexes a
        # revision BEFORE writing its record (see `register_adapter`). A container dying mid
        # registration can therefore leave an index naming a record that does not exist yet, but
        # never a record the index does not name -- so a nonempty index is never missing a
        # revision, and the only index worth repairing is one that is not there at all.
        #
        # It matters that the check is not trying to be cleverer than that. Detecting a NONEMPTY
        # index that is missing a revision would mean enumerating the run's revisions, which is the
        # unbounded keyspace scan the lock's non-renewable TTL cannot afford; and the cheap proxy
        # for it -- "the index does not name the run's own alias id" -- is worthless, because the
        # alias is indexed before the revision, so it is present in every interrupted state a
        # revision could be missing from. Fixing the write order is what removes the need to detect
        # anything here.
        repaired = await _rebuild_run_members(run_id) if not await _run_members(run_id) else []
        # Under the SAME per-run lock `activate` and registration take. Without it, an in-flight
        # activation can write the alias back to `ready` after this loop disabled it, and undeploy
        # returns success while the run stays callable -- the lost update
        # `alias_compare_and_swap` rules out.
        async with _run_lock(run_id):
            # The membership read is INSIDE the lock. Read before acquiring, it is a snapshot: a
            # registration that completes in the gap adds its revision to the index and this pass
            # never sees it, so the new revision stays `ready`, remains on the GPU, and is callable
            # by its immutable id even though undeploy reported success. Being an indexed lookup
            # rather than a keyspace scan is what makes it affordable to hold the lock across.
            #
            # `repaired` and the two ids are unioned in because the index is a repairable cache,
            # not the source of truth: a run whose registrations all predate this app version has
            # no `members:` key at all. Without this, `_run_members` returns [] and the loop below
            # does nothing -- undeploy answers 200 with empty lists while the adapter keeps
            # serving.
            members = list(
                dict.fromkeys([*await _run_members(run_id), *repaired, adapter_id, run_id])
            )
            # The alias goes LAST, which is what makes this loop safe to lose halfway through. Its
            # cost grows with the run's member count while the lock's lease does not renew -- the
            # TTL cannot be extended atomically on modal.Dict (see `_run_lock`) -- so a long enough
            # run can hand the lock to a concurrent `activate` mid-pass. Disabling the alias FIRST
            # makes that expiry corrupting: the activation writes the alias back to `ready` at a
            # revision this pass has not reached yet, then the pass disables that revision and
            # never revisits the alias, and undeploy returns success with a `ready` alias pointing
            # at a disabled, evicted revision -- a run that answers 404 to every request while its
            # records claim it is serving.
            #
            # Alias last inverts that. Whatever an interleaved activation points the alias at, this
            # pass overwrites the alias afterwards, so the run ends fully disabled either way. And
            # an activation landing after the alias write cannot resurrect it: `activate` re-reads
            # its revision under the lock and 409s because this pass already disabled it.
            #
            # And re-read between passes, because alias-last bounds the DAMAGE of a lost lease but
            # not the omission: a registration landing after this read appends to `members:`, and a
            # pass working from the stale list never reaches that revision -- it settles to `ready`
            # and stays callable by its immutable id while undeploy reports 200. Looping until the
            # membership stops growing closes it, and the loop terminates because each extra pass
            # requires another registration to have landed inside it.
            #
            # `seen` records what a pass VISITED, and a later pass re-checks those anyway. It would
            # be wrong to treat it as "already disabled, never look again": the lock's lease does
            # not renew, so a long run can hand the lock to a concurrent registration mid-undeploy,
            # and re-registering an existing revision resets it to `registered` WITHOUT adding a
            # new member id. Skipping visited members would then exclude it from every later pass
            # while its settle turns it back to `ready`, and DELETE still answers 200 for a run
            # that is directly callable by that revision's immutable id.
            #
            # So each pass walks the full membership and the `disabled` check below does the
            # filtering -- one indexed read per member per pass, against a membership that only
            # grows when a registration actually lands. `seen` survives only to decide when the
            # loop has converged and to name the stragglers.
            seen: set[str] = set()
            converged = False
            for _ in range(_UNDEPLOY_PASSES):
                disabled_here = 0
                for member_id in sorted(members, key=lambda m: m == run_id):
                    candidate = await _read(member_id)
                    if not isinstance(candidate, dict):
                        continue
                    metadata = candidate.get("metadata") or {{}}
                    if metadata.get("run_id") != run_id:
                        continue
                    if candidate.get("status") == "disabled":
                        # Already disabled, so there is no state to change -- but a settle that
                        # skipped its cache reclaim to avoid a cold start left its download on the
                        # volume and flagged it for exactly this pass. Collected here and only
                        # here: this is the one path that revisits a disabled revision.
                        #
                        # Added once, not once per pass: the loop re-reads every member up to
                        # `_UNDEPLOY_PASSES` times, and a marked revision stays marked until the
                        # reclaim below runs, so appending unconditionally would repeat the same
                        # `rmtree` round trip on each pass.
                        if (
                            metadata.get("cache_reclaim_pending")
                            and candidate["adapter_id"] not in reclaimable
                        ):
                            reclaimable.append(candidate["adapter_id"])
                        continue
                    candidate["status"] = "disabled"
                    candidate["metadata"] = {{**metadata, "lifecycle_state": "disabled"}}
                    await _write(candidate)
                    disabled_here += 1
                    if metadata.get("record_type") == "alias":
                        disabled_aliases.append(candidate["adapter_id"])
                    else:
                        disabled_revisions.append(candidate["adapter_id"])
                seen.update(members)
                members = list(dict.fromkeys([*members, *await _run_members(run_id)]))
                if not disabled_here and seen.issuperset(members):
                    # `disabled_here` was counted BEFORE the membership refresh above, so it cannot
                    # speak for a revision revived during that read -- and a revive adds no member
                    # id, so `seen.issuperset` cannot see one either. Both convergence signals are
                    # therefore stale by exactly one Dict round trip. Confirm against the records
                    # themselves before declaring the run down; anything still live keeps the loop
                    # going, and if the budget runs out it lands in `stragglers` and 409s.
                    live = False
                    for member_id in members:
                        candidate = await _read(member_id)
                        if not isinstance(candidate, dict):
                            continue
                        metadata = candidate.get("metadata") or {{}}
                        if (
                            metadata.get("run_id") == run_id
                            and candidate.get("status") != "disabled"
                        ):
                            live = True
                            seen.discard(member_id)
                            break
                    if not live:
                        converged = True
                        break
                    continue
            # The pass budget is bounded, so it can run out with members still unvisited: a
            # registration landing during the final pass is appended by the read above and then
            # never processed. Recorded here but NOT raised here -- returning 200 with a revision
            # still `ready` and directly callable by its immutable id is the one outcome an
            # operator cannot detect, but raising inside the lock would skip the eviction below
            # for every revision this call DID disable. Those are already `disabled`, so a retry
            # passes over them and their `max_loras` slots stay occupied until the container
            # recycles. So: finish the eviction, then report.
            #
            # Unvisited members are not the only way to finish dirty. Re-registering an ALREADY
            # SEEN revision grows neither `members` nor the unseen set, so a run that keeps
            # reviving the same id exhausts the budget with an empty straggler list -- and DELETE
            # would answer 200 while that revision settles back to `ready`. Running out of passes
            # is itself the signal: only a pass that re-read every member and found nothing live
            # sets `converged`, so anything else reports 409 and the retry is the caller's.
            stragglers = [member for member in members if member not in seen]
            if not converged and not stragglers:
                stragglers = [member for member in members if member != run_id]
        # Outside the lock: evicting from the GPU is slow and best effort, and the records are
        # already durably disabled, so holding the lock across it would only block other deploys.
        #
        # And skipped entirely when nothing is warm. Eviction exists to free a `max_loras` slot on
        # a RESIDENT engine; with every container scaled to zero there is no slot to free, and the
        # remote call would START one -- pulling the weights and compiling the base model, minutes
        # of paid GPU time against the 30-minute request timeout, to remove an adapter that is not
        # loaded anywhere. A container that starts later loads from the durable records, which are
        # already `disabled`, so it never brings the adapter back.
        if disabled_revisions and await _engine_is_warm():
            for revision_id in disabled_revisions:
                with contextlib.suppress(Exception):  # gpu eviction is best effort
                    await engine.unregister.remote.aio(revision_id)
        else:
            # The COLD counterpart, and it is not optional. `Engine.unregister` is the only
            # successful-undeploy path that releases the durable `loraid:` claim, so skipping it
            # when nothing is warm left the claim naming a revision that is `disabled` and resident
            # nowhere -- forever. The id is a hash of the adapter id, so a later revision that
            # collides on those 31 bits is then refused by a ghost, and repeated cold undeploys
            # accumulate claims no engine will ever release.
            #
            # Done HERE rather than through a remote call because it is pure Dict work: releasing a
            # claim touches no GPU, and routing it through `Engine` would boot the container the
            # warm check just established is not running. `_release_lora_int_id` is already
            # ownership-checked, so releasing a claim another adapter has since taken is a no-op.
            #
            # RE-TAKEN under the run lock, which registration also holds, so the status read and
            # the release cannot straddle a re-registration. A bare re-read was not enough: it
            # narrowed the window but left the read and the `pop` as two unsynchronized calls, so
            # a POST landing between them still had its fresh claim dropped by this stale
            # undeploy -- and that settle then commits `ready` holding nothing, which is the state
            # this release exists to prevent, reintroduced from the other side.
            #
            # Affordable to hold because it is a small fixed number of Dict calls per disabled
            # revision and nothing slow runs inside it: the engine round trip (`_engine_is_warm`)
            # already happened above, deliberately outside the lock, and the GPU eviction branch
            # stays outside it. That keeps the "no unbounded work under a non-renewable lease"
            # invariant intact.
            async with _run_lock(run_id):
                for revision_id in disabled_revisions:
                    with contextlib.suppress(Exception):  # releasing is best effort, like eviction
                        current = await adapter_records.get.aio(_record_key(revision_id))
                        if isinstance(current, dict) and current.get("status") != "disabled":
                            continue  # revived under this lock's protection; its claim is not ours
                        await _release_lora_int_id(_lora_int_id(revision_id), revision_id)
        # The deferred reclaims, run whether or not anything is warm. Unlike eviction, this has no
        # cheaper time to happen: undeploy is the last event in the run's life, so skipping here
        # leaves the directory on the volume for good. It is also bounded -- one `rmtree` per
        # revision whose load failed while scaled to zero.
        #
        # Dispatched to `reclaim_adapter_cache`, NOT `Engine.discard_cache`: `Engine` carries
        # `gpu=GPU` and loads the base model on enter, so routing this through it would boot and
        # bill a GPU container to run `rmtree` -- exactly the cold-start cost the deferral was
        # introduced to avoid, paid at undeploy instead of at settle.
        for revision_id in reclaimable:
            try:
                await reclaim_adapter_cache.remote.aio(revision_id)
            except Exception:  # reclaiming disk is best effort, but the marker is not
                # Left marked on purpose. Best effort means a failed reclaim must not fail the
                # undeploy -- it does NOT mean forgetting the directory. The marker is the only
                # record that anything still needs collecting, so clearing it after a raise turns
                # a retryable deferral into the permanent leak it was added to prevent; leaving it
                # lets the next delete try again.
                continue
            # Re-taken for the clear. The read-modify-write below raced registration when it ran
            # unlocked: a POST for this revision between the read and the write is reset to
            # `registered` with a fresh `settle_attempt`, and writing the whole stale record back
            # restored `disabled` AND dropped the token, so the settle that POST spawned could
            # never commit -- an accepted registration that can never reach ready.
            async with _run_lock(run_id):
                reclaimed = await _read(revision_id)
                if not isinstance(reclaimed, dict):
                    continue
                metadata = reclaimed.get("metadata") or {{}}
                # Cleared only when the record is STILL disabled, matching the same condition
                # `_discard_cached_adapter` re-checks before deleting. A revision re-registered
                # while this ran keeps its files on purpose -- clearing the marker then would drop
                # the deferral for a directory nothing had collected, which is the leak again.
                if not (
                    metadata.get("cache_reclaim_pending")
                    and reclaimed.get("status") == "disabled"
                ):
                    continue
                # Cleared so a repeated undeploy does not re-run the reclaim on every call. Only
                # the metadata key changes, on the record just read under this lock.
                reclaimed["metadata"] = {{
                    key: value for key, value in metadata.items() if key != "cache_reclaim_pending"
                }}
                await adapter_records.put.aio(_record_key(revision_id), reclaimed)
        # Reported only now, after everything this call did disable has been evicted. 409 says the
        # run is in flux and the retry is theirs to make; what this pass disabled stays disabled
        # and is off the GPU, so a retry converges on the remainder.
        if stragglers:
            raise HTTPException(
                status.HTTP_409_CONFLICT,
                f"{{run_id}} kept receiving registrations while it was being undeployed "
                f"({{len(stragglers)}} still active). the rest of the run is disabled; "
                f"repeat the delete once deploys to this run have stopped.",
            )
        return {{
            "ok": True,
            "run_id": run_id,
            "disabled_aliases": disabled_aliases,
            "disabled_revisions": disabled_revisions,
        }}

    @web.post("/v1/chat/completions")
    async def chat_completions(payload: dict[str, Any], request: Request) -> dict[str, Any]:
        _require_key(request)
        requested = str(payload.get("model") or "")
        # TEXT ONLY, said out loud rather than silently. `flash env eval` sends images as OpenAI
        # `image_url` content blocks and EVERY model in the catalog is image-capable, so this is
        # reachable in ordinary use. The engine renders messages through the chat template and
        # passes token ids alone: nothing fetches or decodes the image, and no `multi_modal_data`
        # reaches vLLM. Served anyway, the model answers having never seen the image and the eval
        # scores those answers as if they were valid. Rejected at the HTTP boundary, not in the
        # engine, so the caller gets a 400 naming the reason instead of an opaque RPC failure.
        for message in payload.get("messages") or []:
            content = message.get("content") if isinstance(message, dict) else None
            if not isinstance(content, list):
                continue
            if any(
                isinstance(block, dict) and block.get("type") in ("image", "image_url")
                for block in content
            ):
                raise HTTPException(
                    status.HTTP_400_BAD_REQUEST,
                    "this serving backend is text-only: it does not decode images or pass "
                    "multi_modal_data to vLLM, so serving an image-bearing request would answer "
                    "without seeing the image",
                )
        # An explicit limit is validated here rather than defaulted away. `or 512` cannot tell an
        # omitted field from a supplied 0, so `max_tokens: 0` -- an invalid request -- silently
        # became a 512-token generation the caller pays for, and a negative reached vLLM and came
        # back as an opaque 500. Rejected at the boundary, because the check below runs inside the
        # Engine where a raise becomes an RPC failure rather than a readable 400.
        limit = payload.get("max_tokens")
        if limit is not None and (not isinstance(limit, int) or isinstance(limit, bool) or limit < 1):
            raise HTTPException(
                status.HTTP_400_BAD_REQUEST,
                f"max_tokens must be a positive integer, got {{limit!r}}",
            )
        # Same reasoning for the sampling knobs, which share the same `or` fallback and the same
        # engine-side failure mode. `top_p: 0` is the one that is not merely an opaque 500: it is
        # falsy, so it silently became 1.0 and the request was served with sampling the caller did
        # not ask for. Ranges are vLLM's own: temperature >= 0, 0 < top_p <= 1.
        for field, low, high, low_ok in (("temperature", 0.0, None, True), ("top_p", 0.0, 1.0, False)):
            value = payload.get(field)
            if value is None:
                continue
            if isinstance(value, bool) or not isinstance(value, (int, float)):
                raise HTTPException(
                    status.HTTP_400_BAD_REQUEST, f"{{field}} must be a number, got {{value!r}}"
                )
            # Finiteness FIRST, because the range test below cannot catch either non-finite case.
            # json accepts `1e400` and the bare literals `Infinity` and `NaN`: the first two parse
            # to inf, which passes `temperature >= 0` since temperature has no upper bound, and
            # NaN defeats every ordered comparison at once -- `nan <= 0.0` and `nan > 1.0` are both
            # False, so it passes even a two-sided bound. Either one reaches the GPU as a sampling
            # parameter no caller can have meant.
            if not math.isfinite(value):
                raise HTTPException(
                    status.HTTP_400_BAD_REQUEST, f"{{field}} must be finite, got {{value!r}}"
                )
            if (value < low if low_ok else value <= low) or (high is not None and value > high):
                bound = f"in ({{low}}, {{high}}]" if high is not None else f">= {{low}}"
                raise HTTPException(
                    status.HTTP_400_BAD_REQUEST, f"{{field}} must be {{bound}}, got {{value!r}}"
                )
        record = await _read(requested)
        if record is None or record.get("status") == "disabled":
            raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {{requested}}")
        metadata = record.get("metadata") or {{}}
        # A run id is an ALIAS; resolve it to the immutable revision actually serving right now.
        if metadata.get("record_type") == "alias":
            target = metadata.get("alias_of")
            record = await _read(target) if target else None
            if record is None:
                raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {{requested}}")
        resolved_state = (record.get("metadata") or {{}}).get("lifecycle_state")
        # A revision that reached a TERMINAL state is a hard miss, not a slow load. Retrying it is
        # not merely wasteful: a plane's deployment smoke honours `retryable` and would poll a
        # permanently dead adapter until its budget expired, reporting a timeout instead of the
        # failure that actually happened. Only `registered` is still on its way to ready.
        if record.get("status") == "disabled" or resolved_state in ("disabled", "failed"):
            raise HTTPException(status.HTTP_404_NOT_FOUND, f"unknown model {{requested}}")
        if resolved_state != "ready":
            # A retryable envelope in the shape flash's deployment smoke understands, so it waits
            # for a cold start instead of failing the deploy. Returned as an explicit JSONResponse,
            # NOT raised: FastAPI wraps HTTPException detail as {{"detail": ...}}, and the client
            # matches on a TOP-LEVEL "error" object, so a raise here would never be recognized as
            # retryable. The envelope must echo the model the caller asked for.
            return JSONResponse(
                status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
                headers={{"Retry-After": "2"}},
                content={{
                    "error": {{
                        "type": "adapter_unavailable",
                        "code": "adapter_loading",
                        "retryable": True,
                        "requested_model": requested,
                        "adapter_revision": requested,
                        "retry_after_seconds": 2,
                    }}
                }},
            )
        started = time.time()
        served_revision = record["adapter_id"]
        served_metadata = record.get("metadata") or {{}}
        checkpoint = record.get("checkpoint") or ""
        hf_revision = served_metadata.get("hf_revision") or served_revision.rsplit(".", 1)[-1]
        provenance_headers = {{
            "X-Freesolo-Adapter-Revision": served_revision,
            "X-Freesolo-Checkpoint": checkpoint,
            "X-Freesolo-HF-Revision": hf_revision,
        }}
        # Provenance: which immutable revision actually answered. A plane runs a bounded smoke
        # before it flips an alias, and it rejects the deploy unless the response says exactly
        # which artifact served it -- both as this object and as the matching headers above.
        # Reported from the RESOLVED record, never echoed from the request, so it states what
        # served rather than what was asked for.
        provenance = {{
            "adapter_revision": served_revision,
            "checkpoint": checkpoint,
            "hf_revision": hf_revision,
        }}

        if payload.get("stream"):
            # The route advertises OpenAI compatibility, so `stream: true` has to produce SSE. A
            # one-shot JSON body here is not merely non-incremental: an OpenAI client parses the
            # response as an event stream and fails outright. flash's own client happens to carry a
            # JSON fallback, which is exactly why this would have gone unnoticed in-house while
            # breaking every direct client.
            async def _events():
                chunk_id = f"chatcmpl-{{uuid.uuid4().hex}}"
                created = int(started)

                def _chunk(delta: dict[str, Any], finish_reason) -> str:
                    frame = {{
                        "id": chunk_id,
                        "object": "chat.completion.chunk",
                        "created": created,
                        "model": requested,
                        "choices": [
                            {{"index": 0, "delta": delta, "finish_reason": finish_reason}}
                        ],
                        # Same provenance the one-shot body carries, on every chunk: a streaming
                        # caller never sees the JSON body, so omitting it here would make which
                        # artifact answered depend on how the caller asked.
                        "freesolo": provenance,
                    }}
                    return f"data: {{json.dumps(frame)}}\n\n"

                yield _chunk({{"role": "assistant", "content": ""}}, None)
                async for piece in engine.generate_stream.remote_gen.aio(payload, record):
                    if piece.get("finish_reason"):
                        yield _chunk({{}}, piece["finish_reason"])
                    elif piece.get("delta"):
                        yield _chunk({{"content": piece["delta"]}}, None)
                yield "data: [DONE]\n\n"

            return StreamingResponse(
                _events(),
                media_type="text/event-stream",
                headers={{
                    **provenance_headers,
                    # Proxies that buffer would defeat the point of streaming at all.
                    "Cache-Control": "no-cache",
                    "X-Accel-Buffering": "no",
                }},
            )

        result = await engine.generate.remote.aio(payload, record)
        body = {{
            "id": f"chatcmpl-{{uuid.uuid4().hex}}",
            "object": "chat.completion",
            "created": int(started),
            "model": requested,
            "choices": [
                {{
                    "index": 0,
                    "message": {{"role": "assistant", "content": result["text"]}},
                    "finish_reason": result.get("finish_reason") or "stop",
                }}
            ],
            "usage": {{
                "prompt_tokens": result.get("prompt_tokens") or 0,
                "completion_tokens": result.get("completion_tokens") or 0,
                "total_tokens": (result.get("prompt_tokens") or 0)
                + (result.get("completion_tokens") or 0),
            }},
            "freesolo": provenance,
        }}
        return JSONResponse(content=body, headers=provenance_headers)

    return web
