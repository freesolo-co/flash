# Flash prebuilt WORKER image — the full training stack baked in for RunPod workers.
# the worker fetches one pinned source archive at runtime; the trusted verifier is baked here.
#
# this image name is defined in flash/providers/_lifecycle/worker.py. it must be
# published to GHCR and the package set PUBLIC (no registry login is configured) so RunPod can
# pull it. Normally built by
# .github/workflows/worker-image.yml (manual dispatch); to build/push by hand:
#
#   docker build -f Dockerfile.worker -t ghcr.io/freesolo-co/flash-worker:cu128 .
#   docker push ghcr.io/freesolo-co/flash-worker:cu128
#   # then make the GHCR package public (org packages settings) once.
#
# Base is torch 2.10 / cu12.8 / cudnn9 (-devel = has nvcc for any source builds); it ships the
# CUDA 12.8 runtime libs the PyPI wheels link against. The exact install block below is the deployed
# worker stack source of truth; the fallback verl venv is kept in lockstep in capabilities.py.
# digest-pinned so worker rebuilds reuse the exact torch and cuda base image bytes.
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-devel@sha256:b574d4ccf6d8856a5d87dcadc667aa4f95dc18d337ef3a28d02b7b01897d7081

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1

# Compiled-kernel cache dirs (Triton JIT + TorchInductor). Point both backends at a stable on-image
# location so a BAKED mega-cache (below, opt-in) lands where the runtime looks, and so a first-run
# JIT on a cold worker writes here too. These ENVs are always set (cheap); whether the dir is
# pre-populated is what the opt-in bake controls. engine.worker._load_kernel_cache_if_present reads
# /opt/flash/kernelcache at boot.
# FLASHINFER_CUBIN_DIR / FLASHINFER_CACHE_DIR / FLASHINFER_WORKSPACE_BASE: FlashInfer's attention-backend
# cubins (the Blackwell sm120 / B200 rollout attention backend) are NOT bundled in the wheel — flashinfer
# downloads them from NVIDIA Artifactory on first use. Bake the cubin store + JIT cache into the same
# persistent kernelcache tree so
# a baked/volume cache serves them and a cold worker never re-fetches from Artifactory (kernel_warmup
# also sets these). FLASHINFER_WORKSPACE_BASE is the var flashinfer 0.6.x actually reads to relocate the
# JIT host-wrapper cache (FLASHINFER_CACHE_DIR is a DERIVED constant there, not an env knob), so set it
# too — otherwise a B200 path that touches flashinfer before kernel_warmup runs lands the wrapper under
# the default home workspace and re-JITs instead of using the baked cache.
ENV TRITON_CACHE_DIR=/opt/flash/kernelcache/triton \
    TORCHINDUCTOR_CACHE_DIR=/opt/flash/kernelcache/inductor \
    FLASHINFER_CUBIN_DIR=/opt/flash/kernelcache/flashinfer_cubin \
    FLASHINFER_CACHE_DIR=/opt/flash/kernelcache/flashinfer \
    FLASHINFER_WORKSPACE_BASE=/opt/flash/kernelcache/flashinfer
RUN mkdir -p /opt/flash/kernelcache/triton /opt/flash/kernelcache/inductor \
    /opt/flash/kernelcache/flashinfer_cubin /opt/flash/kernelcache/flashinfer

# build-essential for Triton/Inductor + any source builds; git for pip VCS installs.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git curl \
    && rm -rf /var/lib/apt/lists/*

# The pinned worker stack (torch already in the base image, version-matched so pip skips it).
# exact pins preserve the already-resolved worker environment across image rebuilds.
RUN pip install --no-cache-dir \
    "transformers==5.12.1" \
    "peft==0.20.0" \
    "vllm==0.19.1" \
    "flashinfer-python==0.6.6" \
    "bitsandbytes==0.50.1" \
    "datasets==5.0.1" \
    "huggingface_hub==1.28.0" \
    "accelerate==1.14.0" \
    "wandb==0.28.2" \
    "flash-linear-attention @ git+https://github.com/fla-org/flash-linear-attention.git@9c8e42e762fce087c27b673af4922795d9edb85e" \
    "flash-qla==0.1.2" \
    "tilelang==0.1.9" \
    "apache-tvm-ffi==0.1.9" \
    "hf_transfer==0.1.9" \
    "freesolo==0.4.2" \
    "runpod==1.12.0"
# Gated-DeltaNet (Qwen3.5/3.6) runs on flash-linear-attention's Triton kernels. On consumer cards
# (Ampere/Ada/Blackwell) the Triton path is correct. On Hopper (sm90) fla's GDN chunk_bwd is
# miscomputed with Triton>=3.4 (fla #640) — the fix is fla's TILELANG backend (correct there), so
# we bake the pinned tilelang==0.1.9 + apache-tvm-ffi==0.1.9 (0.1.12 double-registers TVM-FFI ->
# `import tilelang` aborts) and KEEP fla on every arch; flash.engine.worker.perf._ensure_fla_fastpath_on_hopper
# ensures the tilelang backend is live on sm90 before any model import. The INVERSE holds on
# B200/sm100: THERE the tilelang chunk_bwd_dqkwg miscomputes gradients while the Triton path is
# correct — and the pinned fla default-enables tilelang wherever it imports (i.e. everywhere,
# since it is baked here for Hopper), so the worker opts sm100 out via FLA_TILELANG=0
# (engine.worker.perf._force_fla_triton_gdn_on_sm100; upstream default-gates tilelang to
# Hopper-only since fla #975). Validated win vs the old
# pure-PyTorch fallback (H100 SXM, Qwen3.5 hidden-2560 LoRA): seq4096 4.2x faster / 1.6x less mem,
# seq16384 12.6x / 1.9x, loss matches to 1.8e-4. fla is from git: the PyPI wheel is a broken stub
# (no fla.modules). The git URL is PINNED to a commit (not the moving default branch) for
# reproducible image builds; keep this sha in lockstep with the worker dependencies in flash/providers/_lifecycle/worker.py.
# tilelang is 0.1.9, not the newest release: flash-qla (added for the sm90 GDN backend) hard-requires
# tilelang==0.1.9 AND apache-tvm-ffi==0.1.9, so 0.1.11 made this layer unsatisfiable and every image
# build failed from 2026-08-12 until the downgrade. 0.1.11 was only ever "latest stable at the time"
# (the pin exists for determinism, not to dodge a 0.1.9 defect), and the version predates flash-qla.
# Keep all four sites in lockstep -- both installs here, capabilities.py, and perf's TILELANG_PIN --
# because perf fails CLOSED: a resolved version != TILELANG_PIN deletes fla and drops sm90 to the
# pure-PyTorch fallback, which is correct but far slower.

# FlashAttention: PREFER a prebuilt wheel. There is no OFFICIAL Dao-AILab wheel for torch 2.10 yet,
# but community CI publishes matching wheels (cu128/torch2.10/cp312); CI passes one as FLASH_ATTN_SPEC
# (see .github/workflows/worker-image.yml). Installing a wheel takes seconds and gives full arch
# coverage. Compiling FA2 from source instead is enormous (tens of GB RAM, ~1h for 5 arches) and
# OOM-killed/starved every CI runner we tried — so a source spec is only viable on a big-RAM host.
# FLASH_ATTN_SPEC is a pip spec: a wheel URL (preferred) or a pinned "flash-attn==X". It DEFAULTS to
# the same validated cu128/torch2.10/cp312 wheel CI passes, like FLASH_ATTN_3_SPEC below, because the
# verl venv further down hard-REQUIRES flash_attn (verl's remove-padding path imports it unguarded,
# with no SDPA fallback). A source-build default would hard-fail that layer on any builder without
# tens of GB of RAM, including the hand-build command in this file's header.
# NOTE: keep this default in sync with .github/workflows/worker-image.yml's FA2_SPEC.
ARG FLASH_ATTN_SPEC=https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.9.0/flash_attn-2.8.3%2Bcu128torch2.10-cp312-cp312-linux_x86_64.whl
# sha256 of the wheel FLASH_ATTN_SPEC defaults to, kept in lockstep with backend_common's
# FLASH_ATTN_SHA256. The wheel is a community rebuild published by an individual, not Dao-AILab, and
# a github release asset can be deleted and re-uploaded at the same url by whoever holds the account,
# so the url alone pins nothing, and this is the interpreter that trains. Same discipline as the
# infisical .deb in Dockerfile: download, verify, then install. Bump it together with the url (and
# worker-image.yml's FA2_SPEC). A url spec with an empty sha is refused, not installed unverified.
ARG FLASH_ATTN_SHA256=a58c95a080363606e691c342d47dd173b510f4c013a8c5fcb8744def12e36a0f
# Source-build only (ignored when FLASH_ATTN_SPEC is a wheel, i.e. by default): bound the compile so it
# doesn't OOM. TORCH_CUDA_ARCH_LIST restricts to the catalog's arches — Ampere (8.0 A100 / 8.6
# 3090/A40), Ada (8.9 4090), Hopper (9.0 H100), Blackwell datacenter (10.0 B200; sm100) + workstation (12.0 RTX 5090/Pro 6000; sm120); MAX_JOBS bounds
# peak compile memory. (A from-source build still needs a big-RAM host; the wheel avoids all of it.)
# A download fault stays best-effort (SDPA fallback); a hash mismatch never does, it fails the
# build rather than baking a binary nobody can identify.
# pip validates a downloaded wheel's filename against {name}-{version}(-{build})?-{python}-{abi}-
# {platform}.whl and rejects anything else outright ("is not a valid wheel filename"), so the
# curl target must be the url's own basename, not a fixed name -- percent-decoded, since the
# default url encodes "+" as %2B and a bare "+" is legal in a wheel version. Landed in a per-install
# temp dir so an override url's basename can never collide with anything else on the layer.
RUN set -eu; \
    spec="${FLASH_ATTN_SPEC}"; \
    workdir=""; \
    case "${spec}" in \
        http*) \
            [ -n "${FLASH_ATTN_SHA256}" ] || { echo "FLASH_ATTN_SHA256 is required for a wheel url" >&2; exit 1; }; \
            workdir="$(mktemp -d)"; \
            wheel_name="$(python3 -c 'import posixpath, sys, urllib.parse as u; print(posixpath.basename(u.unquote(u.urlsplit(sys.argv[1]).path)))' "${spec}")"; \
            wheel="${workdir}/${wheel_name}"; \
            curl -fsSL -o "${wheel}" "${spec}" \
                || { rm -rf "${workdir}"; echo "flash-attn: wheel download failed, SDPA fallback"; exit 0; }; \
            echo "${FLASH_ATTN_SHA256}  ${wheel}" | sha256sum -c -; \
            spec="${wheel}" ;; \
    esac; \
    TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0 12.0" MAX_JOBS=4 \
    pip install --no-cache-dir "${spec}" --no-build-isolation \
    && echo "flash-attn: installed (${FLASH_ATTN_SPEC})" || echo "flash-attn: build failed, SDPA fallback"; \
    [ -z "${workdir}" ] || rm -rf "${workdir}"

# FlashAttention-3 is NOT installed. It was, on the theory that the trainer would use it for the
# Hopper full-attention layers, but it never reached the training forward for two independent
# reasons and the wheel was pure build cost:
#
#   1. WRONG INTERPRETER. The install was a bare `pip install`, which targets THIS interpreter.
#      Training runs in /opt/verl-venv, built without --system-site-packages (see the comment above
#      the causal_conv1d install below), so the two have disjoint paths. FA2 and causal-conv1d both
#      install with an explicit `--python /opt/verl-venv/bin/python`; FA3 never did, and the verl
#      venv's own import assertion checks flash_attn + fla but never flash_attn_interface.
#   2. NEVER SELECTED. Nothing sets `attn_implementation`, and verl hard-defaults it to
#      "flash_attention_2" (verl/workers/config/model.py: the override_config.get default), so
#      transformers dispatched FA2 on every arch regardless of what was installed.
#
# `FLASH_DISABLE_FA3`, described at the time as the escape hatch, was itself already a dead key
# filtered by providers/_lifecycle/worker.py's _REMOVED_OPTIMIZATION_ENV.
#
# Re-adding FA3 means doing BOTH: install into /opt/verl-venv AND plumb attn_implementation through
# to the child, gated to sm90. Do not re-add the wheel alone -- that is the state this removes.

# causal_conv1d: the short depthwise causal conv kernel whose ``seq_idx`` arg resets the conv at
# example boundaries. Together with fla's ``cu_seqlens`` (which resets the DeltaNet recurrence) it
# lets the GatedDeltaNet hybrids (Qwen3.5/3.6) PACK boundary-correctly — a 4D block-diagonal mask
# alone only fixes the full-attention layers (the verl child's capability probe gates the
# SFT packing path on this import). GPU-validated (RTX 5090, Qwen3.5-0.8B): a packed example's output
# is byte-identical regardless of its neighbors' content (zero cross-example leakage).
# Arch-bounded to the catalog GPUs to cap build time. PINNED (compiled CUDA extension) for
# reproducible image builds — an unpinned upstream release could silently change behavior or break
# the build. 1.6.2.post1 builds Blackwell/sm120 kernels (RTX 5090, flash's default GPU); older lines
# (e.g. 1.5.2) import fine but raise "no kernel image is available for execution on the device" at
# the first conv forward on sm120 — GPU-verified.
#
# REQUIRED here for the same reason as the verl venv copy below, and kept in the same && chain so an
# ABI-broken build fails the image: transformers' is_causal_conv1d_available() is only a find_spec
# probe, so a present-but-broken package would pass it and then crash at Qwen3.5 model load. This
# interpreter is not where training runs (that is /opt/verl-venv), but it is where the parent-side
# probes in engine.worker.packing execute, and a parent that cannot import the kernel cannot answer
# the packing question the same way the child would.
RUN TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0 12.0" CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS=4 \
    pip install --no-cache-dir "causal-conv1d==1.6.2.post1" --no-build-isolation \
    && python -c "import causal_conv1d" \
    && echo "causal_conv1d: installed (GDN packing enabled)"

# weight cache (runtime, not baked): when the shared weight-cache network volume is attached,
# flash/providers/_lifecycle/worker.py:weight_cache_env redirects only base-model prefetching through
# FLASH_WEIGHT_CACHE_DIR to the persistent volume for reuse across runs. HF_HOME remains ephemeral,
# so environment and reward downloads are not shared. executable kernel-jit caches are deliberately
# not shared because the volume is multi-tenant; a poisoned compiled artifact could affect another
# tenant. the redirect cannot be a static image environment variable: the volume mounts at a fixed
# path only at runtime and only when attached, so a baked redirect would break cache-less cold runs.
#
# Compiled-kernel cache: OPT-IN bake, JIT fallback. The fused Triton (fla),
# TorchInductor, and Hopper tilelang kernels the trainer builds on first use are content-addressed
# by GPU ARCH + toolchain version, so they can only be compiled on a real GPU of each catalog arch
# (8.0/8.6/8.9/9.0/12.0) — which the CI image builder normally lacks (the FA2 *source* path above
# already OOMs runners; arch-specific kernel compiles are worse). #194 reintroduced that ~10-15 min
# first-use JIT as a per-run RUNTIME cost on a cold worker.
#
# OPT-IN PATH: build on a real GPU runner with --build-arg BUILD_KERNEL_CACHE=true after running
# flash/engine/worker/runtime/kernel_warmup.py there to produce a portable mega-cache under build/kernel_cache/
# (torch.compiler.save_cache_artifacts). The conditional COPY below then bakes it into
# /opt/flash/kernelcache, and engine.worker._load_kernel_cache_if_present loads it at boot
# (torch.compiler.load_cache_artifacts) — measured cold compile ~124s -> warm load ~0.2s (537x).
#
# FALLBACK (the DEFAULT, BUILD_KERNEL_CACHE=false): NOTHING is baked and the build needs no GPU. The
# first-run JIT happens on the worker exactly as before; flash #163's init heartbeat keeps the stall
# detector quiet through it. So the opt-in is purely additive — an absent cache changes nothing.
#
# The COPY is made safe-when-absent with the standard "COPY a path that always exists + a guard"
# trick. `build/kernel_cache/` is checked into the repo with just a `.keep` placeholder, so the COPY
# source ALWAYS exists (a bare glob that matches nothing is a hard BuildKit error — this avoids it).
# kernel_warmup.py drops `mega_cache.bin` + `mega_cache.json` (+ triton/inductor cache trees) next
# to that placeholder on a GPU builder. COPY STRAIGHT to the final /opt/flash/kernelcache so a
# multi-GB baked cache lives in exactly ONE layer -- staging in /tmp then cp/mv would leave the
# bytes in BOTH the COPY layer and the RUN layer (doubling image size). with the default the dir
# holds only `.keep`, so the copy is harmless; the guard just removes any stale cache + logs.
ARG BUILD_KERNEL_CACHE=false
COPY build/kernel_cache/ /opt/flash/kernelcache/
RUN if [ "${BUILD_KERNEL_CACHE}" = "true" ] && [ -f /opt/flash/kernelcache/mega_cache.bin ]; then \
      echo "kernel-cache: baked from build/kernel_cache/ -> /opt/flash/kernelcache"; \
    else \
      rm -rf /opt/flash/kernelcache/mega_cache.bin /opt/flash/kernelcache/mega_cache.json \
        /opt/flash/kernelcache/triton /opt/flash/kernelcache/inductor; \
      mkdir -p /opt/flash/kernelcache/triton /opt/flash/kernelcache/inductor; \
      echo "kernel-cache: not baked (BUILD_KERNEL_CACHE=${BUILD_KERNEL_CACHE}) -> first-run JIT fallback"; \
    fi

# Sanity: the worker imports must succeed (catches a broken stack at build time, not run time).
# Import EVERY package the worker runtime uses (derived from a full AST scan of the engine/envs/
# bootstrap code + the WORKER_DEPS list above): the core stack, the optimizer/accelerator libs
# (flash-linear-attention=fla, flash_attn, bitsandbytes, triton), and the HF/env libs. A
# missing or ABI-broken package fails the build HERE instead of silently shipping (the FA wheel in
# particular can install yet fail to import against this torch). cuDNN comes from the base image.
# flash_attn is BEST-EFFORT (the install above tolerates a build failure -> SDPA fallback), so it
# is imported optionally here: a missing FA must NOT abort the build, or the SDPA-fallback image
# could never be produced. The rest of the stack is mandatory.
RUN python -c "import importlib.metadata as M; \
import torch, transformers, peft, vllm, datasets, huggingface_hub, accelerate, wandb, \
fla, bitsandbytes, hf_transfer, triton, freesolo, runpod; \
import importlib; \
fa_ok = False; \
exec('try:\n import flash_attn\n fa_ok = True\nexcept Exception:\n fa_ok = False'); \
fa3_ok = False; \
exec('try:\n import flash_attn_interface\n fa3_ok = True\nexcept Exception:\n fa3_ok = False'); \
fi_ok = False; \
exec('try:\n import flashinfer\n fi_ok = True\nexcept Exception:\n fi_ok = False'); \
cudnn = torch.backends.cudnn.version(); assert cudnn, 'cuDNN not compiled into torch'; \
ver = lambda n: M.version(n); \
print('worker stack OK | torch', torch.__version__, '| cudnn', cudnn, '| triton', triton.__version__, '| flash_attn', 'present' if fa_ok else 'ABSENT (SDPA fallback)', '| flash_attn_3', 'present (Hopper FA3)' if fa3_ok else 'ABSENT (SDPA on Hopper)', '| flashinfer', 'present (B200 MoE/attn)' if fi_ok else 'ABSENT (Triton fused-MoE fallback)'); \
[print('  ', d, ver(d)) for d in ['transformers','peft','vllm','flashinfer-python','datasets','huggingface-hub', \
'accelerate','wandb','flash-linear-attention','bitsandbytes', \
'hf-transfer','freesolo','runpod']]"

# ---------------------------------------------------------------------------------------------
# verl venv (GRPO/OPD/SFT verl backends): ISOLATED from the main interpreter on purpose.
#
# verl's dependency set CONFLICTS with the worker stack above. verl and TransferQueue declare
# numpy<2.0.0 while this image's stack resolves numpy>=2, and verl's structured-OPD gate pins
# xgrammar to exactly 0.1.25 against vLLM's declared >=0.1.32 floor. Resolving verl into the main
# interpreter would move shared pins under every other worker path (peft/transformers/vllm all
# live there), so verl gets its own venv and flash launches it out-of-process via FLASH_VERL_PYTHON.
# The venv deliberately re-resolves its own numpy independent of the base interpreter's.
#
# Without this venv the runtime falls back to resolve_verl_python(), which provisions the same set on
# the pod. Keep the two in lockstep: verl's install_requires omits vllm/uvicorn/fastapi/cachetools
# while importing them at module level on the launch path, so any dependency dropped from ONE of
# these two lists yields an interpreter where `verl.trainer.main_ppo` dies on ModuleNotFoundError:
# cachetools and `main_ppo_sync` dies on uvicorn. Baking them here keeps the image from paying the
# fallback's install cost on every run; it is not what makes the backends runnable.
#
# vLLM is pinned to 0.19.1, matching the base stack above so the image carries ONE vLLM version.
# That deliberately exceeds verl's declared vllm<=0.12.0 ceiling. The metadata-clean alternative
# (0.11.2, which satisfies the ceiling and makes `uv pip check` green) was rejected on a model-
# contract fact: Qwen/Qwen3.5-4B is flash's DEFAULT_MODEL and enables GRPO+OPD, both of which set
# rollout.name=vllm, and 0.11.2 registers neither Qwen3_5ForConditionalGeneration nor
# Qwen3_5MoeForConditionalGeneration, so it cannot run rollouts for the default model at all.
# The ceiling is stale for the async rollout path regardless: verl 0.8.0's own stable Dockerfile
# defaults to vllm 0.20.2, its Qwen3.5 GRPO examples require 0.18.0, and vllm_async_server.py
# branches explicitly on 0.13+/0.17+/0.20+ behavior.
#
# Three metadata violations are DELIBERATE, and `uv pip check` stays red in here by design:
#   verl + transferqueue declare numpy<2.0.0   -> vLLM 0.19.1 needs numpy>=2 (declarations are stale)
#   verl declares vllm>=0.8.5,<=0.12.0         -> we ship 0.19.1 (see the ceiling discussion above)
#   vllm declares xgrammar>=0.1.32             -> structured OPD gates on EXACTLY 0.1.25
# xgrammar 0.1.25 was exercised against vLLM 0.19.1's own XgrammarBackend (schema compile, grammar
# build, token-mask fill+apply) so the floor is not required to drive the API.
#
# Those three violations are why this uses `uv pip install --override` and NOT plain pip. pip has no
# escape hatch for a deliberate metadata violation: it either resolves or it refuses, and here it
# refuses with `ResolutionImpossible: Cannot install numpy==2.2.6 and verl` (verl 0.8.0 pins
# numpy<2.0.0). uv's --override is the mechanism this pin set was validated with. All three violated
# pins must appear in the override file: dropping the vllm line alone is still unsatisfiable
# (verl[vllm] depends on vllm<=0.12.0 while we require 0.19.1).
#
# `uv venv` rather than `python -m venv` because the pytorch base image ships no ensurepip, so
# `python -m venv` fails outright ("The virtual environment was not created successfully because
# ensurepip is not available"). --seed puts pip in the venv anyway. uv itself is already in the base
# image at /usr/local/bin/uv.
#
# Four pins are non-obvious and load-bearing: datasets>=4.7 (older raises AttributeError on PyArrow
# PyExtensionType), TransferQueue (absent from verl's setup.py, but OPD calls tq.init()/tq.close()),
# transformers<5.13 (see below), and wandb (also absent from verl's setup.py). verl calls wandb.init from THIS interpreter, not
# flash's, so a job that sets WANDB_API_KEY loses its curves and run link unless wandb is importable
# in here; resolve_verl_loggers() degrades to console when it is not, which is the right behaviour
# for a foreign FLASH_VERL_PYTHON but silently drops W&B on the default image (codex[bot]).
#
# cachetools/uvicorn/fastapi/torchvision/tqdm/pyarrow are named for the same reason
# resolve_verl_python names them: verl imports them at MODULE level on the launch path (main_ppo ->
# ppo.ray_trainer -> rollout.llm_server imports cachetools; rollout.utils imports uvicorn + fastapi)
# yet declares none of them. Some arrive as transitive vllm deps today, but that is vllm's dependency
# choice, not a contract verl states. This image sets FLASH_VERL_PYTHON, so live workers never take
# the resolve_verl_python path where that hardening lives -- letting the two lists drift means the
# fallback protects nobody and a vllm respin breaks launch on the default image alone. Keep them in
# lockstep with verl/capabilities.py's install list.
#
# transformers is exact-pinned in both the direct list and override file to the version this image
# already resolved. verl and vllm both depend on transformers, so without the exact override a
# transitive requirement can re-widen even an exact direct pin. the
# venv is the interpreter that trains, and transformers owns the gdn modelling code the boundary-
# reset shim patches (chunk_gated_delta_rule, the causal conv, and the kwargs they read). the main
# interpreter carrying an exact pin protects nothing in here (/opt/verl-venv is built without
# --system-site-packages). changing this exact pin means re-validating the gdn shim against the new
# version, not just bumping the number.
#
# This pin is NOT what makes the sanity block below pass. is_flash_linear_attention_available() and
# is_causal_conv1d_available() are byte-identical in 5.12.1 and 5.14.1, and both begin with
# is_torch_cuda_available() -- they answer False on this cpu builder at every version. An earlier
# revision of this comment blamed a 5.13 import-path move; no such move exists.
ARG VERL_SPEC=verl[vllm]@git+https://github.com/freesolo-co/verl@f71a02ddb32a9c6a6915f7519bda6dede92e9dd0
ENV FLASH_VERL_PYTHON=/opt/verl-venv/bin/python
RUN printf '%s\n' "numpy==2.2.6" "xgrammar==0.1.25" "vllm==0.19.1" "transformers==5.12.1" > /tmp/verl-overrides.txt \
    && uv venv --seed /opt/verl-venv \
    && VIRTUAL_ENV=/opt/verl-venv uv pip install --python /opt/verl-venv/bin/python \
        --override /tmp/verl-overrides.txt \
        "${VERL_SPEC}" \
        "vllm==0.19.1" \
        "xgrammar==0.1.25" \
        "numpy==2.2.6" \
        "transformers==5.12.1" \
        "datasets==5.0.1" \
        "TransferQueue==0.1.7" \
        "bitsandbytes==0.50.1" "qwen-vl-utils==0.0.14" \
        "wandb==0.28.2" \
        "cachetools==7.1.7" "uvicorn==0.52.4" "fastapi==0.141.1" \
        "torchvision==0.25.0" "tqdm==4.70.0" "pyarrow==25.0.1" \
        "flash-linear-attention @ git+https://github.com/fla-org/flash-linear-attention.git@9c8e42e762fce087c27b673af4922795d9edb85e" \
        "flash-qla==0.1.2" \
        "tilelang==0.1.9" \
        "apache-tvm-ffi==0.1.9" \
    && rm -f /tmp/verl-overrides.txt \
    && uv cache clean

# flash-attn is REQUIRED in here, not best-effort like it is in the main interpreter above. All three
# backends default remove-padding ON (train/rl/verl_config.py, train/sft/config.py,
# train/opd/overrides.py; only a GDN model whose child cannot reset packed boundaries turns it off),
# and verl's CUDA remove-padding path imports
# flash_attn.bert_padding UNGUARDED (verl/utils/attention_utils.py:30, torch_functional.py:627,657).
# There is no SDPA fallback on that path: without the module the run dies at the first training
# batch, which the import-only assert below would not catch. Reuses FLASH_ATTN_SPEC so the venv gets
# the same wheel as the main interpreter instead of a second source build.
# This is /opt/verl-venv/bin/python -- FLASH_VERL_PYTHON, the interpreter that actually trains -- and
# a separate network fetch from the verified main-interpreter download above (that wheel is gone by
# now, --no-cache-dir). uv honours a `#sha256=` url fragment and refuses to install a mismatching
# artifact, the same mechanism flash/engine/worker/backend_common.py's FLASH_ATTN_INSTALL_SPEC
# already relies on, so appending it here closes the gap: a replaced release asset is rejected before
# it lands in the venv that trains, not just in the main interpreter. Unlike that block this install
# has no `|| echo` fallback, so a mismatch already fails the build outright.
# The fragment is appended ONLY to an http(s) url, mirroring the main-interpreter block's case: a
# `#sha256=` fragment is url syntax, so gluing it onto the documented non-url override
# (FLASH_ATTN_SPEC=flash-attn==2.8.3) yields a requirement uv cannot parse and fails this required
# layer outright. A package pin passes through unchanged and resolves from the index as before.
RUN set -eu; \
    spec="${FLASH_ATTN_SPEC}"; \
    case "${spec}" in \
        http*) \
            [ -n "${FLASH_ATTN_SHA256}" ] || { echo "FLASH_ATTN_SHA256 is required for a wheel url" >&2; exit 1; }; \
            spec="${spec}#sha256=${FLASH_ATTN_SHA256}" ;; \
    esac; \
    TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0 12.0" MAX_JOBS=4 \
    uv pip install --python /opt/verl-venv/bin/python --no-build-isolation "${spec}" \
    && uv cache clean

# causal_conv1d in the VERL VENV, which is where the model actually trains. The main interpreter's
# copy above does not reach here: /opt/verl-venv is built without --system-site-packages, so the two
# have disjoint paths. Together with fla's cu_seqlens (installed above) this is what makes the packed
# GDN boundary resets real rather than decorative: engine.worker.backend_common's boundary shim hands
# the GDN layer cu_seq_lens_q + seq_idx, but transformers' pure-torch fallbacks take **kwargs and
# silently DISCARD both, so a child missing these kernels trains across example boundaries while
# looking patched. verl_child_can_reset_gdn_boundaries probes this venv for exactly that reason.
#
# REQUIRED, not best-effort. This was best-effort on the premise that a failed build degrades to
# unpacked training, and that premise no longer holds: every catalog model is a GDN hybrid, and
# backend_common.require_gdn_boundary_resets now RAISES for grpo/opd when the child cannot reset,
# because the old padded fallback (use_remove_padding=False) is incompatible with the
# use_fused_kernels=True these recipes hardcode and dies at padding.py:144 on every batch size.
# So a conv-less image does not train unpacked here -- it fails grpo and opd after paying for the
# gpu. Failing the BUILD is strictly cheaper than failing the run. No `|| uninstall` branch: the
# import check below is part of the same && chain, so an ABI-broken build (which passes
# transformers' find_spec probe) fails the image rather than shipping as present-but-broken.
RUN TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0 12.0" CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS=4 \
    uv pip install --python /opt/verl-venv/bin/python "causal-conv1d==1.6.2.post1" --no-build-isolation \
    && /opt/verl-venv/bin/python -c "import causal_conv1d" \
    && echo "causal_conv1d (verl venv): installed (GDN boundary resets enabled)"

# Neutralize tilelang's libcudart stub in THIS venv, after the last install that can write tilelang
# into it (the install above and the flash-attn one before it) and before anything imports vLLM here.
# vLLM aborts its import when it finds that stub (it has no cudaDeviceReset) in /proc/self/maps, and
# this venv is where the child actually trains, so an unrepaired stub kills grpo/opd on a rented gpu.
#
# resolve_verl_python applies the same repair to the venv it provisions itself, but it returns a
# preset FLASH_VERL_PYTHON untouched -- flash does not own a foreign interpreter -- and this image
# sets that variable (above), so live workers take the early return and never reach it. That makes
# this the ONLY place the production venv gets repaired.
#
# The script is EXTRACTED from _CHILD_CUDART_FIX rather than copied: both paths repair the same venv
# and must not drift. It is stdlib-only by construction (the venv has no flash), which the extractor
# asserts. Part of the same && chain: a stub left shadowing libcudart exits nonzero and fails the
# BUILD, which is strictly cheaper than failing the run after the gpu is paid for -- the same
# discipline as the causal_conv1d layer above.
COPY flash/engine/worker/verl/capabilities.py docker/extract_cudart_fix.py /tmp/cudartfix/
RUN python /tmp/cudartfix/extract_cudart_fix.py /tmp/cudartfix/capabilities.py /tmp/cudartfix/fix.py \
    && /opt/verl-venv/bin/python /tmp/cudartfix/fix.py \
    && rm -rf /tmp/cudartfix

# Sanity: the verl venv must be able to LAUNCH, not merely install. This is the assert that would
# have caught the shipped-but-unrunnable venv. Import the three entrypoints flash actually invokes
# (rl_train -> main_ppo, opd_plugin -> main_ppo_sync, sft_train -> sft_trainer; note it is
# sft_trainer, NOT fsdp_sft_trainer, which does not exist in this pin), the vLLM rollout modules
# where a version mismatch would surface, and the fork-only rollout field the GRPO path emits as a
# hydra override. Also assert the Qwen3.5 archs are registered, since that is the entire reason this
# venv carries 0.19.1 instead of 0.11.2.
#
# fla and causal_conv1d are asserted here as INSTALLED AND IMPORTABLE, not via transformers'
# is_flash_linear_attention_available() / is_causal_conv1d_available(). Both of those begin with
# is_torch_cuda_available(), and this image is built on a cpu runner (ubuntu-24.04-8core), so both
# answer False no matter what is installed -- an unsatisfiable assert that fails every build. What a
# cpu CAN prove is what this checks: the packages import, and fla is at least the 0.2.2 the probe
# demands, so a device-bearing worker will get True. The capability itself is asserted where a gpu
# exists: verl_child_can_reset_gdn_boundaries runs the real probes in the child, and
# backend_common.require_gdn_boundary_resets RAISES for grpo/opd before a step runs.
#
# The stakes, unchanged: without fla transformers binds chunk_gated_delta_rule to the pure-torch
# fallback, which accepts cu_seqlens and discards it, and without causal_conv1d the conv falls back
# to F.silu(self.conv1d(...)), which takes no seq_idx at all -- so packed GDN runs would train across
# example boundaries. The conv is the DOMINANT channel of the two: on a real Qwen3_5TextModel,
# honoring seq_idx alone cuts cross-example contamination from 9.47e-02 to 1.63e-05, while segmenting
# only the recurrence barely moves it.
RUN /opt/verl-venv/bin/python -c "import importlib.metadata as M; \
import importlib; \
from packaging import version; \
[importlib.import_module(m) for m in ('verl.trainer.main_ppo','verl.trainer.main_ppo_sync','verl.trainer.sft_trainer')]; \
[importlib.import_module(m) for m in ('verl.workers.rollout.vllm_rollout.vllm_rollout','verl.workers.rollout.vllm_rollout.vllm_async_server')]; \
from verl.workers.config.rollout import RolloutConfig; \
assert 'mask_truncated_completions' in RolloutConfig.__dataclass_fields__, 'verl is not the freesolo fork (no mask_truncated_completions)'; \
importlib.import_module('flash_attn.bert_padding'); \
importlib.import_module('fla'); \
assert version.parse(M.version('flash-linear-attention')) >= version.parse('0.2.2'), 'flash-linear-attention older than the 0.2.2 transformers requires: packed GDN boundary resets would be silently discarded'; \
importlib.import_module('causal_conv1d'); \
assert M.version('verl') == '0.8.0', 'opd structured gate requires verl exactly 0.8.0, got ' + M.version('verl'); \
assert M.version('xgrammar') == '0.1.25', 'opd structured gate requires xgrammar exactly 0.1.25, got ' + M.version('xgrammar'); \
from vllm import ModelRegistry; \
archs = set(ModelRegistry.get_supported_archs()); \
missing = {'Qwen3_5ForConditionalGeneration','Qwen3_5MoeForConditionalGeneration'} - archs; \
assert not missing, 'vllm cannot serve the default-model archs: ' + repr(sorted(missing)); \
print('verl venv OK | verl', M.version('verl'), '| vllm', M.version('vllm'), '| torch', M.version('torch'), '| numpy', M.version('numpy'), '| xgrammar', M.version('xgrammar')); \
print('  entrypoints: main_ppo (grpo), main_ppo_sync (opd), sft_trainer (sft)'); \
print('  qwen3.5 archs registered; mask_truncated_completions present'); \
print('  gdn boundary resets: fla', M.version('flash-linear-attention'), 'and causal_conv1d installed and importable (capability itself is cuda-gated, asserted on the worker)')"

# RunPod Serverless worker entrypoint (Pattern D — Flash custom image). Generate /rp_handler.py
# from the real _train_body source in providers/runpod/serverless/endpoints.py (single source of truth;
# _train_body is self-contained — every name is imported inside its body) and run it as the CMD so the
# image is a self-contained RunPod Serverless worker. Build context is the repo root.
COPY flash/providers/runpod/serverless/endpoints.py flash/source_snapshot.py docker/make_rp_handler.py /tmp/rpgen/
RUN cp /tmp/rpgen/source_snapshot.py /source_snapshot.py \
    && python /tmp/rpgen/make_rp_handler.py /tmp/rpgen/endpoints.py /tmp/rpgen/source_snapshot.py /rp_handler.py \
    && python -c "import ast; ast.parse(open('/rp_handler.py').read()); print('rp_handler OK')"
CMD ["python", "-u", "/rp_handler.py"]
