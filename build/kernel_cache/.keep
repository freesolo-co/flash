# placeholder so Dockerfile.worker's `COPY build/kernel_cache/` source always exists.
# the opt-in baked compiled-kernel cache (raw kernels + architecture metadata) is produced here by
# `python -m flash.engine.worker.runtime.kernel_warmup --out build/kernel_cache`, then baked into the image
# with `docker build --build-arg BUILD_KERNEL_CACHE=true`.
