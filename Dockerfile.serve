# immutable flash serving runtime with the repository's existing cuda base family
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-devel

# PIP_BREAK_SYSTEM_PACKAGES matches Dockerfile.worker, which shares this base image. The base
# ships a Debian-style PEP 668 marker (/usr/lib/python3.12/EXTERNALLY-MANAGED), so the pinned-uv
# bootstrap below fails with "externally-managed-environment" without it and the image never
# builds. The base already carries an older uv (0.9.26); the bootstrap exists to pin the exact
# hash-verified version, so it replaces that one rather than installing into a bare environment.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_PROJECT_ENVIRONMENT=/opt/flash-venv \
    PATH=/opt/flash-venv/bin:${PATH}

WORKDIR /app

RUN python -c 'import sys; assert sys.version_info[:2] == (3, 12)' \
    && printf '%s\n' \
        'uv==0.12.3 --hash=sha256:1482d1462b1aecd18ee33627363fe1c63d6a194f12d40d37efc446d9e0d800a1' \
        > /tmp/uv-requirements.txt \
    && python -m pip install --no-cache-dir --index-url https://pypi.org/simple \
        --require-hashes -r /tmp/uv-requirements.txt \
    && rm -f /tmp/uv-requirements.txt

COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY flash ./flash
COPY serve_launch.py ./serve_launch.py
RUN uv sync --frozen --no-dev --extra serve-runtime

EXPOSE 8000
CMD ["python", "/app/serve_launch.py"]
