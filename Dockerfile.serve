# immutable flash serving runtime with the repository's existing cuda base family
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-devel

# PIP_BREAK_SYSTEM_PACKAGES matches Dockerfile.worker, which shares this base image. The base
# ships a Debian-style PEP 668 marker (/usr/lib/python3.12/EXTERNALLY-MANAGED), so the pinned-uv
# bootstrap below fails with "externally-managed-environment" without it and the image never
# builds. The base already carries an older uv (0.9.26); the bootstrap exists to pin the exact
# hash-verified version, so it replaces that one rather than installing into a bare environment.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_PROJECT_ENVIRONMENT=/opt/flash-venv \
    PATH=/opt/flash-venv/bin:${PATH}

WORKDIR /app

RUN python -c 'import sys; assert sys.version_info[:2] == (3, 12)' \
    && printf '%s\n' \
        'uv==0.12.3 --hash=sha256:1482d1462b1aecd18ee33627363fe1c63d6a194f12d40d37efc446d9e0d800a1' \
        > /tmp/uv-requirements.txt \
    && python -m pip install --no-cache-dir --index-url https://pypi.org/simple \
        --require-hashes -r /tmp/uv-requirements.txt \
    && rm -f /tmp/uv-requirements.txt

COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY flash ./flash
COPY serve_launch.py ./serve_launch.py
RUN uv sync --frozen --no-dev --extra serve-runtime

# vllm 0.23.0 requires torch==2.11.0 exactly, and PyPI's default torch 2.11.0 wheel is built for
# CUDA 13. This base image is cuda12.8, and a RunPod L4 host reports driver 12080, so that wheel
# aborts engine init with "The NVIDIA driver on your system is too old (found version 12080)" --
# every pod died there, ~2s in, restarting forever.
#
# Same versions, CUDA-matched build: PyTorch's own cu128 index publishes 2.11.0+cu128 (and the
# matching torchvision/torchaudio), so this keeps the resolved dependency graph intact and only
# swaps the CUDA the binaries were compiled against. Pinning here rather than in uv.lock keeps the
# lockfile a single cross-platform resolution while the image states the CUDA its base provides,
# the same way Dockerfile.worker version-matches torch to this base.
#
# `uv pip`, not `python -m pip`: uv builds the venv without pip in it, so `python -m pip` here
# fails with "No module named pip". --no-deps so nothing re-resolves what uv already pinned.
RUN uv pip install --no-cache --no-deps \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.11.0+cu128 torchvision==0.26.0+cu128 torchaudio==2.11.0+cu128 \
    && /opt/flash-venv/bin/python -c "import torch; v=torch.version.cuda; assert v and v.startswith('12.8'), f'expected a cu128 torch, got {torch.__version__} (cuda {v})'; print('torch', torch.__version__, 'cuda', v)"

EXPOSE 8000
CMD ["python", "/app/serve_launch.py"]
